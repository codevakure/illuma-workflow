# =============================================================================
# Illuma V2 Frontend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# API URL (empty = same-origin via Vite proxy, or full URL for deployed API)
VITE_API_URL=

# Socket Server URL (for real-time collaboration)
VITE_SOCKET_URL=http://localhost:3002
