        "type": "short-input",
        "title": "Site ID or Domain",
        "placeholder": "e.g., 12345678 or yoursite.wordpress.com"
      },
      {
        "id": "postId",
        "type": "short-input",
        "title": "Post ID",
        "placeholder": "Enter post ID"
      },
      {
        "id": "title",
        "type": "short-input",
        "title": "Title",
        "placeholder": "Post or page title"
      },
      {
        "id": "content",
        "type": "long-input",
        "title": "Content",
        "placeholder": "Post or page content (HTML or plain text)"
      },
      {
        "id": "status",
        "type": "dropdown",
        "title": "Status",
        "options": [
          {
            "label": "Publish",
            "value": "publish"
          },
          {
            "label": "Draft",
            "value": "draft"
          },
          {
            "label": "Pending",
            "value": "pending"
          },
          {
            "label": "Private",
            "value": "private"
          }
        ]
      },
      {
        "id": "excerpt",
        "type": "long-input",
        "title": "Excerpt",
        "placeholder": "Post or page excerpt"
      },
      {
        "id": "slug",
        "type": "short-input",
        "title": "Slug",
        "placeholder": "URL slug (optional)"
      },
      {
        "id": "categories",
        "type": "short-input",
        "title": "Categories",
        "placeholder": "Comma-separated category IDs"
      },
      {
        "id": "tags",
        "type": "short-input",
