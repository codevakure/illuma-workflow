{
  "id": "lemlist",
  "name": "Lemlist",
  "version": "1.0.0",
  "description": "Manage outreach activities, leads, and send emails via Lemlist",
  "icon": "LemlistIcon",
  "block": {
    "type": "lemlist",
    "name": "Lemlist",
    "description": "Manage outreach activities, leads, and send emails via Lemlist",
    "longDescription": "Integrate Lemlist into your workflow. Retrieve campaign activities and replies, get lead information, and send emails through the Lemlist inbox.",
    "docsLink": "https://docs.sim.ai/tools/lemlist",
    "category": "tools",
    "bgColor": "#316BFF",
    "icon": "LemlistIcon",
    "authMode": "api_key",
    "subBlocks": [
      {
        "id": "selectedTriggerId",
        "type": "dropdown",
        "title": "Trigger Event",
        "mode": "trigger"
      },
      {
        "id": "operation",
        "type": "dropdown",
        "title": "Operation",
        "options": [
          {
            "label": "Get Activities",
            "value": "get_activities"
          },
          {
            "label": "Get Lead",
            "value": "get_lead"
          },
          {
            "label": "Send Email",
            "value": "send_email"
          }
        ]
      },
      {
        "id": "type",
        "type": "dropdown",
        "title": "Activity Type",
        "options": [
          {
            "label": "Email Opened",
            "value": "emailOpened"
          },
          {
            "label": "Email Clicked",
            "value": "emailClicked"
          },
          {
            "label": "Email Replied",
            "value": "emailReplied"
          },
          {
            "label": "Email Sent",
            "value": "emailsSent"
          },
          {
            "label": "Email Bounced",
            "value": "emailsBounced"
          },
          {
            "label": "Paused",
            "value": "paused"
          },
          {
            "label": "Interested",
            "value": "interested"
          },
          {
            "label": "Not Interested",
            "value": "notInterested"
          }
        ]
      },
      {
        "id": "campaignId",
        "type": "short-input",
        "title": "Campaign ID",
        "placeholder": "Filter by campaign ID (optional)"
      },
      {
        "id": "filterLeadId",
        "type": "short-input",
        "title": "Lead ID",
        "placeholder": "Filter by lead ID (optional)"
      },
      {
        "id": "limit",
        "type": "short-input",
        "title": "Limit",
        "placeholder": "100 (max)"
      },
      {
        "id": "offset",
        "type": "short-input",
        "title": "Offset",
        "placeholder": "0"
      },
      {
        "id": "email",
        "type": "short-input",
        "title": "Email Address",
        "placeholder": "Enter lead email address",
        "mode": "basic",
        "canonicalParamId": "leadIdentifier"
      },
      {
        "id": "leadIdLookup",
        "type": "short-input",
        "title": "Lead ID",
        "placeholder": "Enter lead ID",
        "mode": "advanced",
        "canonicalParamId": "leadIdentifier"
      },
      {
        "id": "sendUserId",
        "type": "short-input",
        "title": "Sender User ID",
        "placeholder": "Your Lemlist user ID"
      },
      {
        "id": "sendUserEmail",
        "type": "short-input",
        "title": "Sender Email",
        "placeholder": "Your email address"
      },
      {
        "id": "sendUserMailboxId",
        "type": "short-input",
        "title": "Mailbox ID",
        "placeholder": "Your mailbox ID"
      },
      {
        "id": "contactId",
        "type": "short-input",
        "title": "Contact ID",
        "placeholder": "Recipient contact ID"
      },
      {
        "id": "leadId",
        "type": "short-input",
        "title": "Lead ID",
        "placeholder": "Associated lead ID"
      },
      {
        "id": "subject",
        "type": "short-input",
        "title": "Subject",
        "placeholder": "Email subject"
      },
      {
        "id": "message",
        "type": "long-input",
        "title": "Message",
        "placeholder": "Email message body (HTML supported)"
      },
      {
        "id": "apiKey",
        "type": "short-input",
        "title": "API Key",
        "placeholder": "Enter your Lemlist API key",
        "password": true
      },
      {
        "id": "webhookUrlDisplay",
        "type": "short-input",
        "title": "Webhook URL",
        "readOnly": true,
        "showCopyButton": true,
        "useWebhookUrl": true,
        "placeholder": "Webhook URL will be generated",
        "mode": "trigger"
      },
      {
        "id": "triggerSave",
        "type": "trigger-save",
        "title": "",
        "hideFromPreview": true,
        "mode": "trigger",
        "triggerId": "lemlist_webhook"
      },
      {
        "id": "triggerInstructions",
        "type": "text",
        "title": "Setup Instructions",
        "hideFromPreview": true,
        "mode": "trigger",
        "default": "<div class='mb-3'><strong>1.</strong> Go to your Lemlist settings > Integrations > Webhooks.</div><div class='mb-3'><strong>2.</strong> Add the Webhook URL above.</div><div class='mb-3'><strong>3.</strong> Select the events you want to trigger on.</div>"
      }
    ],
    "tools": {
      "access": [
        "lemlist_get_activities",
        "lemlist_get_lead",
        "lemlist_send_email"
      ],
      "config": {
        "tool": "{{operation}}"
      }
    },
    "inputs": {
      "operation": {
        "type": "string"
      }
    },
    "outputs": {
      "activities": {
        "type": "json"
      }
    },
    "triggers": {
      "enabled": true,
      "available": ["lemlist_webhook", "lemlist_email_replied", "lemlist_email_opened", "lemlist_email_clicked", "lemlist_email_sent", "lemlist_email_bounced", "lemlist_linkedin_replied", "lemlist_interested", "lemlist_not_interested"]
    },
    "triggerAllowed": true
  },
  "tools": [
    {
      "id": "lemlist_get_activities",
      "name": "Lemlist Get Activities",
      "description": "Retrieves campaign activities and steps performed, including email opens, clicks, replies, and other events.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "lemlist",
        "operation": "lemlist_get_activities"
      }
    },
    {
      "id": "lemlist_get_lead",
      "name": "Lemlist Get Lead",
      "description": "Retrieves lead information by email address or lead ID.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "lemlist",
        "operation": "lemlist_get_lead"
      }
    },
    {
      "id": "lemlist_send_email",
      "name": "Lemlist Send Email",
      "description": "Sends an email to a contact through the Lemlist inbox.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "lemlist",
        "operation": "lemlist_send_email"
      }
    }
  ],
  "triggers": [
    {
      "id": "lemlist_email_replied",
      "name": "Lemlist Email Replied",
      "provider": "lemlist",
      "description": "Trigger when an email is replied to",
      "version": "1.0.0",
      "webhook": { "method": "POST" },
      "credentials": [
        {
          "id": "apiKey",
          "label": "API Key",
          "type": "password",
          "required": true,
          "description": "Lemlist API Key",
          "placeholder": "Enter API key"
        }
      ],
      "outputs": {
        "_id": { "type": "string", "description": "Activity ID" },
        "type": { "type": "string", "description": "Activity type (emailsReplied)" },
        "createdAt": { "type": "string", "description": "ISO 8601 timestamp" },
        "teamId": { "type": "string", "description": "Team ID" },
        "leadId": { "type": "string", "description": "Lead ID" },
        "campaignId": { "type": "string", "description": "Campaign ID" },
        "email": { "type": "string", "description": "Lead email" },
        "firstName": { "type": "string", "description": "Lead first name" },
        "lastName": { "type": "string", "description": "Lead last name" },
        "subject": { "type": "string", "description": "Email subject" },
        "text": { "type": "string", "description": "Reply text" }
      }
    },
    {
      "id": "lemlist_linkedin_replied",
      "name": "Lemlist LinkedIn Replied",
      "provider": "lemlist",
      "description": "Trigger when a LinkedIn message is replied to",
      "version": "1.0.0",
      "webhook": { "method": "POST" },
      "credentials": [
        {
          "id": "apiKey",
          "label": "API Key",
          "type": "password",
          "required": true,
          "description": "Lemlist API Key",
          "placeholder": "Enter API key"
        }
      ],
      "outputs": {
        "_id": { "type": "string", "description": "Activity ID" },
        "type": { "type": "string", "description": "Activity type (linkedinReplied)" },
        "createdAt": { "type": "string", "description": "ISO 8601 timestamp" },
        "text": { "type": "string", "description": "Reply text" }
      }
    },
    {
      "id": "lemlist_interested",
      "name": "Lemlist Lead Interested",
      "provider": "lemlist",
      "description": "Trigger when a lead is marked as interested",
      "version": "1.0.0",
      "webhook": { "method": "POST" },
      "credentials": [
        {
          "id": "apiKey",
          "label": "API Key",
          "type": "password",
          "required": true,
          "description": "Lemlist API Key",
          "placeholder": "Enter API key"
        }
      ],
      "outputs": {
        "_id": { "type": "string", "description": "Activity ID" },
        "type": { "type": "string", "description": "Activity type (interested)" },
        "createdAt": { "type": "string", "description": "ISO 8601 timestamp" },
        "email": { "type": "string", "description": "Lead email" }
      }
    },
    {
      "id": "lemlist_not_interested",
      "name": "Lemlist Lead Not Interested",
      "provider": "lemlist",
      "description": "Trigger when a lead is marked as not interested",
      "version": "1.0.0",
      "webhook": { "method": "POST" },
      "credentials": [
        {
          "id": "apiKey",
          "label": "API Key",
          "type": "password",
          "required": true,
          "description": "Lemlist API Key",
          "placeholder": "Enter API key"
        }
      ],
      "outputs": {
        "_id": { "type": "string", "description": "Activity ID" },
        "type": { "type": "string", "description": "Activity type (notInterested)" },
        "createdAt": { "type": "string", "description": "ISO 8601 timestamp" },
        "email": { "type": "string", "description": "Lead email" }
      }
    },
    {
      "id": "lemlist_email_opened",
      "name": "Lemlist Email Opened",
      "provider": "lemlist",
      "description": "Trigger when an email is opened",
      "version": "1.0.0",
      "webhook": { "method": "POST" },
      "credentials": [
        {
          "id": "apiKey",
          "label": "API Key",
          "type": "password",
          "required": true,
          "description": "Lemlist API Key",
          "placeholder": "Enter API key"
        }
      ],
      "outputs": {
        "_id": { "type": "string", "description": "Activity ID" },
        "type": { "type": "string", "description": "Activity type (emailsOpened)" },
        "createdAt": { "type": "string", "description": "ISO 8601 timestamp" },
        "email": { "type": "string", "description": "Lead email" }
      }
    },
    {
      "id": "lemlist_email_clicked",
      "name": "Lemlist Email Clicked",
      "provider": "lemlist",
      "description": "Trigger when an email link is clicked",
      "version": "1.0.0",
      "webhook": { "method": "POST" },
      "credentials": [
        {
          "id": "apiKey",
          "label": "API Key",
          "type": "password",
          "required": true,
          "description": "Lemlist API Key",
          "placeholder": "Enter API key"
        }
      ],
      "outputs": {
        "_id": { "type": "string", "description": "Activity ID" },
        "type": { "type": "string", "description": "Activity type (emailsClicked)" },
        "createdAt": { "type": "string", "description": "ISO 8601 timestamp" },
        "email": { "type": "string", "description": "Lead email" },
        "clickedUrl": { "type": "string", "description": "URL that was clicked" }
      }
    },
    {
      "id": "lemlist_email_bounced",
      "name": "Lemlist Email Bounced",
      "provider": "lemlist",
      "description": "Trigger when an email bounces",
      "version": "1.0.0",
      "webhook": { "method": "POST" },
      "credentials": [
        {
          "id": "apiKey",
          "label": "API Key",
          "type": "password",
          "required": true,
          "description": "Lemlist API Key",
          "placeholder": "Enter API key"
        }
      ],
      "outputs": {
        "_id": { "type": "string", "description": "Activity ID" },
        "type": { "type": "string", "description": "Activity type (emailsBounced)" },
        "createdAt": { "type": "string", "description": "ISO 8601 timestamp" },
        "email": { "type": "string", "description": "Lead email" },
        "errorMessage": { "type": "string", "description": "Bounce error message" }
      }
    },
    {
      "id": "lemlist_email_sent",
      "name": "Lemlist Email Sent",
      "provider": "lemlist",
      "description": "Trigger when an email is sent",
      "version": "1.0.0",
      "webhook": { "method": "POST" },
      "credentials": [
        {
          "id": "apiKey",
          "label": "API Key",
          "type": "password",
          "required": true,
          "description": "Lemlist API Key",
          "placeholder": "Enter API key"
        }
      ],
      "outputs": {
        "_id": { "type": "string", "description": "Activity ID" },
        "type": { "type": "string", "description": "Activity type (emailsSent)" },
        "createdAt": { "type": "string", "description": "ISO 8601 timestamp" },
        "email": { "type": "string", "description": "Lead email" },
        "subject": { "type": "string", "description": "Email subject" }
      }
    },
    {
      "id": "lemlist_webhook",
      "name": "Lemlist Webhook (All Events)",
      "provider": "lemlist",
      "description": "Trigger on any Lemlist webhook event",
      "version": "1.0.0",
      "webhook": { "method": "POST" },
      "credentials": [
        {
          "id": "apiKey",
          "label": "API Key",
          "type": "password",
          "required": true,
          "description": "Lemlist API Key",
          "placeholder": "Enter API key"
        }
      ],
      "outputs": {
        "_id": { "type": "string", "description": "Activity ID" },
        "type": { "type": "string", "description": "Activity type" },
        "createdAt": { "type": "string", "description": "ISO 8601 timestamp" },
        "teamId": { "type": "string", "description": "Team ID" }
      }
    }
  ]
}
