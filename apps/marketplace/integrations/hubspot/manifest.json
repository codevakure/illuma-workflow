      {
        "id": "clientId",
        "type": "short-input",
        "title": "Client ID",
        "placeholder": "Enter your HubSpot app Client ID",
        "description": "Found in your HubSpot app settings under Auth tab",
        "required": true,
        "mode": "trigger"
      },
      {
        "id": "clientSecret",
        "type": "short-input",
        "title": "Client Secret",
        "placeholder": "Enter your HubSpot app Client Secret",
        "description": "Found in your HubSpot app settings under Auth tab",
        "password": true,
        "required": true,
        "mode": "trigger"
      },
      {
        "id": "appId",
        "type": "short-input",
        "title": "App ID",
        "placeholder": "Enter your HubSpot App ID",
