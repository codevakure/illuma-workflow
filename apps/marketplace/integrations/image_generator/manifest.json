{
  "id": "image_generator",
  "name": "Image Generator",
  "version": "1.0.0",
  "description": "Generate images",
  "icon": "ImageIcon",
  "block": {
    "type": "image_generator",
    "name": "Image Generator",
    "description": "Generate images",
    "longDescription": "Integrate Image Generator into the workflow. Can generate images using DALL-E 3 or GPT Image.",
    "docsLink": "https://docs.sim.ai/tools/image_generator",
    "category": "tools",
    "bgColor": "#4D5FFF",
    "icon": "ImageIcon",
    "authMode": "api_key",
    "subBlocks": [
      {
        "id": "model",
        "type": "dropdown",
        "title": "Model",
        "options": [
          {
            "label": "DALL-E 3",
            "value": "dall-e-3"
          },
          {
            "label": "GPT Image",
            "value": "gpt-image-1"
          }
        ]
      },
      {
        "id": "prompt",
        "type": "long-input",
        "title": "Prompt",
        "placeholder": "Describe the image you want to generate..."
      },
      {
        "id": "size",
        "type": "dropdown",
        "title": "Size",
        "options": [
          {
            "label": "1024x1024",
            "value": "1024x1024"
          },
          {
            "label": "1024x1792",
            "value": "1024x1792"
          },
          {
            "label": "1792x1024",
            "value": "1792x1024"
          }
        ]
      },
      {
        "id": "size",
        "type": "dropdown",
        "title": "Size",
        "options": [
          {
            "label": "Auto",
            "value": "auto"
          },
          {
            "label": "1024x1024",
            "value": "1024x1024"
          },
          {
            "label": "1536x1024",
            "value": "1536x1024"
          },
          {
            "label": "1024x1536",
            "value": "1024x1536"
          }
        ]
      },
      {
        "id": "quality",
        "type": "dropdown",
        "title": "Quality",
        "options": [
          {
            "label": "Standard",
            "value": "standard"
          },
          {
            "label": "HD",
            "value": "hd"
          }
        ]
      },
      {
        "id": "style",
        "type": "dropdown",
        "title": "Style",
        "options": [
          {
            "label": "Vivid",
            "value": "vivid"
          },
          {
            "label": "Natural",
            "value": "natural"
          }
        ]
      },
      {
        "id": "background",
        "type": "dropdown",
        "title": "Background",
        "options": [
          {
            "label": "Auto",
            "value": "auto"
          },
          {
            "label": "Transparent",
            "value": "transparent"
          },
          {
            "label": "Opaque",
            "value": "opaque"
          }
        ]
      },
      {
        "id": "apiKey",
        "type": "short-input",
        "title": "API Key",
        "placeholder": "Enter your OpenAI API key",
        "password": true
      }
    ],
    "tools": {
      "access": [
        "openai_image"
      ],
      "config": {
        "tool": "openai_image"
      }
    },
    "inputs": {
      "prompt": {
        "type": "string"
      }
    },
    "outputs": {
      "content": {
        "type": "string"
      }
    }
  },
  "tools": [
    {
      "id": "openai_image",
      "name": "Openai Image",
      "description": "Image Generator image operation",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "vision",
        "operation": "openai_image"
      }
    }
  ]
}
