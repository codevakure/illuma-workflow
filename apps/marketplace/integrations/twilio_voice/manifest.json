{
  "id": "twilio_voice",
  "name": "Twilio Voice",
  "version": "1.0.0",
  "description": "Make and manage phone calls",
  "icon": "TwilioIcon",
  "block": {
    "type": "twilio_voice",
    "name": "Twilio Voice",
    "description": "Make and manage phone calls",
    "longDescription": "Integrate Twilio Voice into the workflow. Make outbound calls and retrieve call recordings.",
    "docsLink": "https://docs.sim.ai/tools/twilio_voice",
    "category": "tools",
    "bgColor": "#F22F46",
    "icon": "TwilioIcon",
    "authMode": "api_key",
    "subBlocks": [
      {
        "id": "operation",
        "type": "dropdown",
        "title": "Operation",
        "options": [
          {
            "label": "Make Call",
            "value": "make_call"
          },
          {
            "label": "List Calls",
            "value": "list_calls"
          },
          {
            "label": "Get Recording",
            "value": "get_recording"
          }
        ]
      },
      {
        "id": "accountSid",
        "type": "short-input",
        "title": "Twilio Account SID",
        "placeholder": "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      },
      {
        "id": "authToken",
        "type": "short-input",
        "title": "Auth Token",
        "placeholder": "Your Twilio Auth Token",
        "password": true
      },
      {
        "id": "to",
        "type": "short-input",
        "title": "To Phone Number",
        "placeholder": "+14155551234"
      },
      {
        "id": "from",
        "type": "short-input",
        "title": "From Twilio Number",
        "placeholder": "+14155556789"
      },
      {
        "id": "url",
        "type": "short-input",
        "title": "TwiML URL",
        "placeholder": "https://example.com/twiml"
      },
      {
        "id": "twiml",
        "type": "long-input",
        "title": "TwiML Instructions",
        "placeholder": "[Response][Say]Hello from Twilio![/Say][/Response]"
      },
      {
        "id": "record",
        "type": "switch",
        "title": "Record Call"
      },
      {
        "id": "timeout",
        "type": "short-input",
        "title": "Timeout (seconds)",
        "placeholder": "60"
      },
      {
        "id": "statusCallback",
        "type": "short-input",
        "title": "Status Callback URL",
        "placeholder": "https://example.com/status"
      },
      {
        "id": "machineDetection",
        "type": "dropdown",
        "title": "Machine Detection",
        "options": [
          {
            "label": "Enable",
            "value": "Enable"
          },
          {
            "label": "Detect Message End",
            "value": "DetectMessageEnd"
          }
        ]
      },
      {
        "id": "listTo",
        "type": "short-input",
        "title": "To Number",
        "placeholder": "+14155551234"
      },
      {
        "id": "listFrom",
        "type": "short-input",
        "title": "From Number",
        "placeholder": "+14155556789"
      },
      {
        "id": "listStatus",
        "type": "dropdown",
        "title": "Status",
        "options": [
          {
            "label": "Queued",
            "value": "queued"
          },
          {
            "label": "Ringing",
            "value": "ringing"
          },
          {
            "label": "In Progress",
            "value": "in-progress"
          },
          {
            "label": "Completed",
            "value": "completed"
          },
          {
            "label": "Failed",
            "value": "failed"
          },
          {
            "label": "Busy",
            "value": "busy"
          },
          {
            "label": "No Answer",
            "value": "no-answer"
          },
          {
            "label": "Canceled",
            "value": "canceled"
          }
        ]
      },
      {
        "id": "listPageSize",
        "type": "short-input",
        "title": "Page Size",
        "placeholder": "50"
      },
      {
        "id": "startTimeAfter",
        "type": "short-input",
        "title": "After (YYYY-MM-DD)",
        "placeholder": "2025-01-01"
      },
      {
        "id": "startTimeBefore",
        "type": "short-input",
        "title": "Before (YYYY-MM-DD)",
        "placeholder": "2025-12-31"
      },
      {
        "id": "recordingSid",
        "type": "short-input",
        "title": "Recording SID",
        "placeholder": "RExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      },
      {
        "id": "webhookUrlDisplay",
        "type": "short-input",
        "title": "Webhook URL",
        "readOnly": true,
        "showCopyButton": true,
        "useWebhookUrl": true,
        "placeholder": "Webhook URL will be generated",
        "mode": "trigger"
      },
      {
        "id": "triggerAccountSid",
        "type": "short-input",
        "title": "Twilio Account SID",
        "placeholder": "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "description": "Your Twilio Account SID from the Twilio Console",
        "required": true,
        "mode": "trigger"
      },
      {
        "id": "triggerAuthToken",
        "type": "short-input",
        "title": "Auth Token",
        "placeholder": "Your Twilio Auth Token",
        "password": true,
        "required": true,
        "description": "Your Twilio Auth Token for webhook signature verification",
        "mode": "trigger"
      },
      {
        "id": "twimlResponse",
        "type": "long-input",
        "title": "TwiML Response",
        "placeholder": "[Response][Say]Please hold.[/Say][/Response]",
        "required": false,
        "description": "TwiML instructions to return immediately to Twilio. Use square brackets instead of angle brackets (e.g., [Response] instead of <Response>). This controls what happens when the call comes in (e.g., play a message, record, gather input). Your workflow will execute in the background.",
        "mode": "trigger",
        "wandConfig": {
          "enabled": true,
          "prompt": "Generate TwiML (Twilio Markup Language) for voice calls based on the user's description.\n\n### IMPORTANT: Use SQUARE BRACKETS instead of angle brackets\n- Use [Tag] instead of <Tag>\n- Use [/Tag] instead of </Tag>\n- Use [Tag/] for self-closing tags instead of <Tag/>\n\n### COMMON TWIML VERBS\n\n**[Say]** - Text-to-speech\n[Say voice=\"alice\"]Hello, how can I help you?[/Say]\n- Voices: alice, man, woman, Polly.Joanna, Polly.Matthew, etc.\n\n**[Play]** - Play audio file\n[Play]https://example.com/audio.mp3[/Play]\n\n**[Record]** - Record caller's voice\n[Record maxLength=\"120\" transcribe=\"true\"/]\n- transcribe=\"true\" to get text transcription\n\n**[Gather]** - Collect keypad input or speech\n[Gather input=\"dtmf speech\" timeout=\"5\" numDigits=\"1\"]\n  [Say]Press 1 for sales, 2 for support.[/Say]\n[/Gather]\n\n**[Dial]** - Connect to another number\n[Dial]+14155551234[/Dial]\n\n**[Pause]** - Add silence\n[Pause length=\"2\"/]\n\n**[Hangup]** - End the call\n[Hangup/]\n\n**[Redirect]** - Redirect to another URL\n[Redirect]https://example.com/next[/Redirect]\n\n### EXAMPLES\n\n\"say hello and ask them to leave a message\"\n-> [Response][Say voice=\"alice\"]Hello! Please leave a message after the beep.[/Say][Record maxLength=\"120\" transcribe=\"true\"/][/Response]\n\n\"greet and offer options: press 1 for sales, 2 for support\"\n-> [Response][Gather input=\"dtmf\" timeout=\"5\" numDigits=\"1\"][Say voice=\"alice\"]Welcome! Press 1 for sales, or press 2 for support.[/Say][/Gather][Say]Sorry, I didn't get that. Goodbye.[/Say][/Response]\n\n\"play hold music\"\n-> [Response][Say voice=\"alice\"]Please hold while we connect you.[/Say][Play loop=\"0\"]https://api.twilio.com/cowbell.mp3[/Play][/Response]\n\n\"just say please wait\"\n-> [Response][Say voice=\"alice\"]Please wait while we process your request.[/Say][/Response]\n\n\"record a voicemail with transcription\"\n-> [Response][Say voice=\"alice\"]You've reached our voicemail. Please leave a message.[/Say][Record transcribe=\"true\" maxLength=\"180\" playBeep=\"true\"/][Say voice=\"alice\"]Thank you for your message. Goodbye.[/Say][/Response]\n\nReturn ONLY the TwiML with square brackets - no explanations, no markdown, no extra text.",
          "placeholder": "Describe what should happen when a call comes in..."
        }
      },
      {
        "id": "triggerSave",
        "type": "trigger-save",
        "title": "",
        "hideFromPreview": true,
        "mode": "trigger",
        "triggerId": "twilio_voice_webhook"
      },
      {
        "id": "triggerInstructions",
        "type": "text",
        "title": "Setup Instructions",
        "hideFromPreview": true,
        "mode": "trigger",
        "default": "<div class='mb-3'><strong>1.</strong> Go to the Twilio Console > Phone Numbers.</div><div class='mb-3'><strong>2.</strong> Select the phone number you want to use.</div><div class='mb-3'><strong>3.</strong> Set the Voice webhook URL to the Webhook URL above.</div><div class='mb-3'><strong>4.</strong> Save your changes.</div>"
      }
    ],
    "tools": {
      "access": [
        "twilio_voice_make_call",
        "twilio_voice_list_calls",
        "twilio_voice_get_recording"
      ],
      "config": {
        "tool": "{{operation}}"
      }
    },
    "inputs": {
      "operation": {
        "type": "string"
      }
    },
    "outputs": {
      "success": {
        "type": "boolean"
      }
    },
    "triggers": {
      "enabled": true,
      "available": ["twilio_voice_webhook"]
    },
    "triggerAllowed": true
  },
  "tools": [
    {
      "id": "twilio_voice_get_recording",
      "name": "Twilio Voice Get Recording",
      "description": "Retrieve call recording information and transcription (if enabled via TwiML).",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "twilio_voice",
        "operation": "twilio_voice_get_recording"
      }
    },
    {
      "id": "twilio_voice_list_calls",
      "name": "Twilio Voice List Calls",
      "description": "Retrieve a list of calls made to and from an account.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "twilio_voice",
        "operation": "twilio_voice_list_calls"
      }
    },
    {
      "id": "twilio_voice_make_call",
      "name": "Twilio Voice Make Call",
      "description": "Make an outbound phone call using Twilio Voice API.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "twilio_voice",
        "operation": "twilio_voice_make_call"
      }
    }
  ],
  "triggers": [
    {
      "id": "twilio_voice_webhook",
      "name": "Twilio Voice Webhook",
      "provider": "twilio-voice",
      "description": "Trigger workflow from incoming Twilio voice calls",
      "version": "1.0.0",
      "webhook": { "method": "POST" },
      "credentials": [
        { "id": "accountSid", "label": "Account SID", "type": "string", "required": true, "description": "Twilio Account SID", "placeholder": "AC..." },
        { "id": "authToken", "label": "Auth Token", "type": "password", "required": true, "description": "Twilio Auth Token for signature verification", "placeholder": "Enter your auth token" }
      ],
      "auth": { "type": "custom", "handler": "twilio_voice_verify_webhook" },
      "outputs": {
        "callSid": { "type": "string", "description": "Unique call identifier" },
        "accountSid": { "type": "string", "description": "Twilio Account SID" },
        "from": { "type": "string", "description": "Caller phone number" },
        "to": { "type": "string", "description": "Called phone number" },
        "callStatus": { "type": "string", "description": "Call status (ringing, in-progress, completed, etc.)" },
        "direction": { "type": "string", "description": "Call direction (inbound/outbound)" },
        "digits": { "type": "string", "description": "DTMF digits pressed" },
        "speechResult": { "type": "string", "description": "Speech recognition result" },
        "recordingUrl": { "type": "string", "description": "Recording URL (if recorded)" },
        "callerName": { "type": "string", "description": "Caller name (if available)" },
        "raw": { "type": "json", "description": "Full webhook payload" }
      }
    }
  ]
}
