{
  "id": "calendly",
  "name": "Calendly",
  "version": "1.0.0",
  "description": "Manage Calendly scheduling and events",
  "icon": "CalendlyIcon",
  "block": {
    "type": "calendly",
    "name": "Calendly",
    "description": "Manage Calendly scheduling and events",
    "longDescription": "Integrate Calendly into your workflow. Manage event types, scheduled events, invitees, and webhooks. Can also trigger workflows based on Calendly webhook events (invitee scheduled, invitee canceled, routing form submitted). Requires Personal Access Token.",
    "docsLink": "https://docs.sim.ai/tools/calendly",
    "category": "tools",
    "bgColor": "#FFFFFF",
    "icon": "CalendlyIcon",
    "authMode": "api_key",
    "subBlocks": [
      {
        "id": "selectedTriggerId",
        "type": "dropdown",
        "title": "Trigger Event",
        "mode": "trigger"
      },
      {
        "id": "operation",
        "type": "dropdown",
        "title": "Operation",
        "options": [
          {
            "label": "Get Current User",
            "value": "calendly_get_current_user"
          },
          {
            "label": "List Event Types",
            "value": "calendly_list_event_types"
          },
          {
            "label": "Get Event Type",
            "value": "calendly_get_event_type"
          },
          {
            "label": "List Scheduled Events",
            "value": "calendly_list_scheduled_events"
          },
          {
            "label": "Get Scheduled Event",
            "value": "calendly_get_scheduled_event"
          },
          {
            "label": "List Event Invitees",
            "value": "calendly_list_event_invitees"
          },
          {
            "label": "Cancel Event",
            "value": "calendly_cancel_event"
          }
        ]
      },
      {
        "id": "apiKey",
        "type": "short-input",
        "title": "Personal Access Token",
        "placeholder": "Enter your Calendly personal access token",
        "password": true
      },
      {
        "id": "eventTypeUuid",
        "type": "short-input",
        "title": "Event Type UUID",
        "placeholder": "Enter event type UUID or URI"
      },
      {
        "id": "user",
        "type": "short-input",
        "title": "User URI",
        "placeholder": "Filter by user URI"
      },
      {
        "id": "organization",
        "type": "short-input",
        "title": "Organization URI",
        "placeholder": "Filter by organization URI (optional)"
      },
      {
        "id": "active",
        "type": "switch",
        "title": "Active Only"
      },
      {
        "id": "invitee_email",
        "type": "short-input",
        "title": "Invitee Email",
        "placeholder": "Filter by invitee email"
      },
      {
        "id": "min_start_time",
        "type": "short-input",
        "title": "Min Start Time",
        "placeholder": "ISO 8601 format (e.g., 2024-01-01T00:00:00Z)"
      },
      {
        "id": "max_start_time",
        "type": "short-input",
        "title": "Max Start Time",
        "placeholder": "ISO 8601 format (e.g., 2024-12-31T23:59:59Z)"
      },
      {
        "id": "status",
        "type": "dropdown",
        "title": "Status",
        "options": [
          {
            "label": "Active",
            "value": "active"
          },
          {
            "label": "Canceled",
            "value": "canceled"
          }
        ]
      },
      {
        "id": "eventUuid",
        "type": "short-input",
        "title": "Event UUID",
        "placeholder": "Enter scheduled event UUID or URI"
      },
      {
        "id": "reason",
        "type": "long-input",
        "title": "Cancellation Reason",
        "placeholder": "Reason for cancellation (optional)"
      },
      {
        "id": "email",
        "type": "short-input",
        "title": "Email",
        "placeholder": "Filter by invitee email"
      },
      {
        "id": "count",
        "type": "short-input",
        "title": "Results Per Page",
        "placeholder": "Number of results (default: 20, max: 100)",
        "max": 100
      },
      {
        "id": "pageToken",
        "type": "short-input",
        "title": "Page Token",
        "placeholder": "Token for pagination"
      },
      {
        "id": "sort",
        "type": "short-input",
        "title": "Sort Order",
        "placeholder": "e.g., "
      },
      {
        "id": "webhookUrlDisplay",
        "type": "short-input",
        "title": "Webhook URL",
        "readOnly": true,
        "showCopyButton": true,
        "useWebhookUrl": true,
        "placeholder": "Webhook URL will be generated",
        "mode": "trigger"
      },
      {
        "id": "webhookSecret",
        "type": "short-input",
        "title": "Webhook Signing Key",
        "placeholder": "Enter your Calendly webhook signing key",
        "password": true,
        "required": false,
        "mode": "trigger"
      },
      {
        "id": "triggerSave",
        "type": "trigger-save",
        "title": "",
        "hideFromPreview": true,
        "mode": "trigger",
        "triggerId": "calendly_webhook"
      },
      {
        "id": "triggerInstructions",
        "type": "text",
        "title": "Setup Instructions",
        "hideFromPreview": true,
        "mode": "trigger",
        "default": "<div class='mb-3'><strong>1.</strong> Go to Calendly Developer Portal > Webhooks.</div><div class='mb-3'><strong>2.</strong> Create a webhook subscription with the Webhook URL above.</div><div class='mb-3'><strong>3.</strong> Select the events you want to listen for.</div>"
      }
    ],
    "tools": {
      "access": [
        "calendly_get_current_user",
        "calendly_list_event_types",
        "calendly_get_event_type",
        "calendly_list_scheduled_events",
        "calendly_get_scheduled_event",
        "calendly_list_event_invitees",
        "calendly_cancel_event"
      ],
      "config": {
        "tool": "{{operation}}"
      }
    },
    "inputs": {
      "operation": {
        "type": "string"
      }
    },
    "outputs": {
      "success": {
        "type": "boolean"
      }
    },
    "triggers": {
      "enabled": true,
      "available": ["calendly_webhook", "calendly_invitee_created", "calendly_invitee_canceled", "calendly_routing_form_submitted"]
    },
    "triggerAllowed": true
  },
  "tools": [
    {
      "id": "calendly_cancel_event",
      "name": "Calendly Cancel Event",
      "description": "Cancel a scheduled event",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "calendly",
        "operation": "calendly_cancel_event"
      }
    },
    {
      "id": "calendly_get_current_user",
      "name": "Calendly Get Current User",
      "description": "Get information about the currently authenticated Calendly user",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "calendly",
        "operation": "calendly_get_current_user"
      }
    },
    {
      "id": "calendly_get_event_type",
      "name": "Calendly Get Event Type",
      "description": "Get detailed information about a specific event type",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "calendly",
        "operation": "calendly_get_event_type"
      }
    },
    {
      "id": "calendly_get_scheduled_event",
      "name": "Calendly Get Scheduled Event",
      "description": "Get detailed information about a specific scheduled event",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "calendly",
        "operation": "calendly_get_scheduled_event"
      }
    },
    {
      "id": "calendly_list_event_invitees",
      "name": "Calendly List Event Invitees",
      "description": "Retrieve a list of invitees for a scheduled event",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "calendly",
        "operation": "calendly_list_event_invitees"
      }
    },
    {
      "id": "calendly_list_event_types",
      "name": "Calendly List Event Types",
      "description": "Retrieve a list of all event types for a user or organization",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "calendly",
        "operation": "calendly_list_event_types"
      }
    },
    {
      "id": "calendly_list_scheduled_events",
      "name": "Calendly List Scheduled Events",
      "description": "Retrieve a list of scheduled events for a user or organization",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "calendly",
        "operation": "calendly_list_scheduled_events"
      }
    }
  ],
  "triggers": [
    {
      "id": "calendly_invitee_created",
      "name": "Calendly Invitee Created",
      "provider": "calendly",
      "description": "Trigger when a new invitee is created for a Calendly event",
      "version": "1.0.0",
      "webhook": { "method": "POST" },
      "credentials": [
        {
          "id": "apiKey",
          "label": "Personal Access Token",
          "type": "password",
          "required": true,
          "description": "Calendly Personal Access Token",
          "placeholder": "Enter your token"
        }
      ],
      "outputs": {
        "event": { "type": "string", "description": "Event type (invitee.created)" },
        "created_at": { "type": "string", "description": "Event creation timestamp" },
        "created_by": { "type": "string", "description": "Calendly user URI" },
        "payload": {
          "type": "object",
          "description": "Invitee data (uri, email, name, first_name, last_name, status, timezone, event, questions_and_answers, tracking, cancel_url, reschedule_url)"
        }
      }
    },
    {
      "id": "calendly_invitee_canceled",
      "name": "Calendly Invitee Canceled",
      "provider": "calendly",
      "description": "Trigger when an invitee cancels a Calendly event",
      "version": "1.0.0",
      "webhook": { "method": "POST" },
      "credentials": [
        {
          "id": "apiKey",
          "label": "Personal Access Token",
          "type": "password",
          "required": true,
          "description": "Calendly Personal Access Token",
          "placeholder": "Enter your token"
        }
      ],
      "outputs": {
        "event": { "type": "string", "description": "Event type (invitee.canceled)" },
        "created_at": { "type": "string", "description": "Event creation timestamp" },
        "payload": { "type": "object", "description": "Invitee data with cancellation details" }
      }
    },
    {
      "id": "calendly_routing_form_submitted",
      "name": "Calendly Routing Form Submitted",
      "provider": "calendly",
      "description": "Trigger when a routing form is submitted",
      "version": "1.0.0",
      "webhook": { "method": "POST" },
      "credentials": [
        {
          "id": "apiKey",
          "label": "Personal Access Token",
          "type": "password",
          "required": true,
          "description": "Calendly Personal Access Token",
          "placeholder": "Enter your token"
        }
      ],
      "outputs": {
        "event": { "type": "string", "description": "Event type (routing_form_submission.created)" },
        "created_at": { "type": "string", "description": "Event creation timestamp" },
        "payload": {
          "type": "object",
          "description": "Routing form data (uri, routing_form, submitter, questions_and_answers, result)"
        }
      }
    },
    {
      "id": "calendly_webhook",
      "name": "Calendly Webhook (All Events)",
      "provider": "calendly",
      "description": "Trigger on any Calendly webhook event",
      "version": "1.0.0",
      "webhook": { "method": "POST" },
      "credentials": [
        {
          "id": "apiKey",
          "label": "Personal Access Token",
          "type": "password",
          "required": true,
          "description": "Calendly Personal Access Token",
          "placeholder": "Enter your token"
        }
      ],
      "outputs": {
        "event": { "type": "string", "description": "Event type" },
        "created_at": { "type": "string", "description": "Event creation timestamp" },
        "payload": { "type": "object", "description": "Event data (varies by event type)" }
      }
    }
  ]
}
