      "description": "Convert text to speech using Azure Cognitive Services",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "tts",
        "operation": "tts_azure"
      }
    },
    {
      "id": "tts_cartesia",
      "name": "Cartesia TTS",
