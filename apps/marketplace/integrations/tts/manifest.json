    "tools": {
      "access": [
        "tts_openai",
        "tts_deepgram",
        "tts_elevenlabs",
        "tts_cartesia",
        "tts_google",
        "tts_azure",
        "tts_playht"
      ],
      "config": {
        "tool": "{{operation}}"
      }
    },
    "inputs": {
      "provider": {
        "type": "string"
      }
    },
    "outputs": {
      "audioUrl": {
        "type": "string"
      }
    }
