{
  "id": "notion",
  "name": "Notion",
  "version": "1.0.0",
  "description": "Manage Notion pages",
  "icon": "NotionIcon",
  "block": {
    "type": "notion",
    "name": "Notion",
    "description": "Manage Notion pages",
    "longDescription": "Integrate with Notion into the workflow. Can read page, read database, create page, update page, create database, add database row, append content, query database, and search workspace.",
    "docsLink": "https://docs.sim.ai/tools/notion",
    "category": "tools",
    "bgColor": "#181C1E",
    "icon": "NotionIcon",
    "authMode": "oauth",
    "hideFromToolbar": false,
    "subBlocks": [
      {
        "id": "operation",
        "type": "dropdown",
        "title": "Operation",
        "options": [
          {
            "label": "Read Page",
            "value": "notion_read"
          },
          {
            "label": "Read Database",
            "value": "notion_read_database"
          },
          {
            "label": "Create Page",
            "value": "notion_create_page"
          },
          {
            "label": "Update Page",
            "value": "notion_update_page"
          },
          {
            "label": "Create Database",
            "value": "notion_create_database"
          },
          {
            "label": "Add Database Row",
            "value": "notion_add_database_row"
          },
          {
            "label": "Append Content",
            "value": "notion_write"
          },
          {
            "label": "Query Database",
            "value": "notion_query_database"
          },
          {
            "label": "Search Workspace",
            "value": "notion_search"
          }
        ]
      },
      {
        "id": "credential",
        "type": "oauth-input",
        "title": "Notion Account",
        "placeholder": "Select Notion account",
        "serviceId": "notion"
      },
      {
        "id": "pageId",
        "type": "short-input",
        "title": "Page ID",
        "placeholder": "Enter Notion page ID",
        "condition": {
          "field": "operation",
          "value": ["notion_read", "notion_write", "notion_update_page"]
        }
      },
      {
        "id": "databaseId",
        "type": "short-input",
        "title": "Database ID",
        "placeholder": "Enter Notion database ID",
        "condition": {
          "field": "operation",
          "value": ["notion_read_database", "notion_query_database", "notion_add_database_row"]
        }
      },
      {
        "id": "parentId",
        "type": "short-input",
        "title": "Parent Page ID",
        "placeholder": "ID of parent page",
        "condition": {
          "field": "operation",
          "value": ["notion_create_page", "notion_create_database"]
        }
      },
      {
        "id": "title",
        "type": "short-input",
        "title": "Title",
        "placeholder": "Title for the new page or database",
        "condition": {
          "field": "operation",
          "value": ["notion_create_page", "notion_create_database"]
        }
      },
      {
        "id": "content",
        "type": "long-input",
        "title": "Content",
        "placeholder": "Enter content to add to the page",
        "condition": {
          "field": "operation",
          "value": ["notion_create_page", "notion_write", "notion_update_page"]
        }
      },
      {
        "id": "properties",
        "type": "code",
        "title": "Properties",
        "placeholder": "Enter properties as JSON object",
        "condition": {
          "field": "operation",
          "value": ["notion_create_database", "notion_add_database_row", "notion_update_page"]
        }
      },
      {
        "id": "filter",
        "type": "code",
        "title": "Filter",
        "placeholder": "Enter filter conditions as JSON (optional)",
        "condition": {
          "field": "operation",
          "value": "notion_query_database"
        }
      },
      {
        "id": "sorts",
        "type": "code",
        "title": "Sort Criteria",
        "placeholder": "Enter sort criteria as JSON array (optional)",
        "condition": {
          "field": "operation",
          "value": "notion_query_database"
        }
      },
      {
        "id": "pageSize",
        "type": "short-input",
        "title": "Page Size",
        "placeholder": "Number of results (default: 100, max: 100)",
        "max": 100,
        "condition": {
          "field": "operation",
          "value": "notion_query_database"
        }
      },
      {
        "id": "query",
        "type": "short-input",
        "title": "Search Query",
        "placeholder": "Enter search terms (leave empty for all pages)",
        "condition": {
          "field": "operation",
          "value": "notion_search"
        }
      },
      {
        "id": "filterType",
        "type": "dropdown",
        "title": "Filter Type",
        "options": [
          {
            "label": "All",
            "value": "all"
          },
          {
            "label": "Pages Only",
            "value": "page"
          },
          {
            "label": "Databases Only",
            "value": "database"
          }
        ],
        "condition": {
          "field": "operation",
          "value": "notion_search"
        }
      }
    ],
    "tools": {
      "access": [
        "notion_read",
        "notion_read_database",
        "notion_write",
        "notion_create_page",
        "notion_update_page",
        "notion_query_database",
        "notion_search",
        "notion_create_database",
        "notion_add_database_row"
      ],
      "config": {
        "tool": "{{operation}}"
      }
    },
    "inputs": {
      "operation": { "type": "string" }
    },
    "outputs": {
      "content": { "type": "string", "description": "Page content in markdown format" },
      "title": { "type": "string", "description": "Page or database title" },
      "url": { "type": "string", "description": "Notion URL" },
      "id": { "type": "string", "description": "Page or database ID" },
      "created_time": { "type": "string", "description": "Creation timestamp" },
      "last_edited_time": { "type": "string", "description": "Last edit timestamp" },
      "results": { "type": "array", "description": "Results from query/search" },
      "has_more": { "type": "boolean", "description": "More results available" },
      "next_cursor": { "type": "string", "description": "Pagination cursor" },
      "total_results": { "type": "number", "description": "Result count" },
      "properties": { "type": "json", "description": "Database schema or page properties" },
      "appended": { "type": "boolean", "description": "Success flag for write/append" }
    }
  },
  "tools": [
    {
      "id": "notion_read",
      "name": "Notion Reader",
      "description": "Read content from a Notion page",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "notion",
        "operation": "notion_read"
      }
    },
    {
      "id": "notion_read_database",
      "name": "Read Notion Database",
      "description": "Read database information and structure from Notion",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "notion",
        "operation": "notion_read_database"
      }
    },
    {
      "id": "notion_write",
      "name": "Notion Content Appender",
      "description": "Append content to a Notion page",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "notion",
        "operation": "notion_write"
      }
    },
    {
      "id": "notion_create_page",
      "name": "Notion Page Creator",
      "description": "Create a new page in Notion",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "notion",
        "operation": "notion_create_page"
      }
    },
    {
      "id": "notion_update_page",
      "name": "Notion Page Updater",
      "description": "Update an existing page in Notion",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "notion",
        "operation": "notion_update_page"
      }
    },
    {
      "id": "notion_query_database",
      "name": "Query Notion Database",
      "description": "Query and filter Notion database entries with advanced filtering",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "notion",
        "operation": "notion_query_database"
      }
    },
    {
      "id": "notion_search",
      "name": "Search Notion Workspace",
      "description": "Search across all pages and databases in Notion workspace",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "notion",
        "operation": "notion_search"
      }
    },
    {
      "id": "notion_create_database",
      "name": "Create Notion Database",
      "description": "Create a new database in Notion with custom properties",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "notion",
        "operation": "notion_create_database"
      }
    },
    {
      "id": "notion_add_database_row",
      "name": "Add Notion Database Row",
      "description": "Add a new row to a Notion database",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "notion",
        "operation": "notion_add_database_row"
      }
    }
  ]
}
