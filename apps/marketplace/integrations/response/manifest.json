{
  "id": "response",
  "name": "Response",
  "version": "1.0.0",
  "description": "Send structured API response",
  "icon": "ResponseIcon",
  "block": {
    "type": "response",
    "name": "Response",
    "description": "Send structured API response",
    "longDescription": "Integrate Response into the workflow. Can send build or edit structured responses into a final workflow response.",
    "docsLink": "https://docs.sim.ai/blocks/response",
    "category": "blocks",
    "bgColor": "#2F55FF",
    "icon": "ResponseIcon",
    "singleInstance": true,
    "subBlocks": [
      {
        "id": "dataMode",
        "title": "Response Data Mode",
        "type": "dropdown",
        "options": [
          {
            "label": "Builder",
            "value": "structured"
          },
          {
            "label": "Editor",
            "value": "json"
          }
        ]
      },
      {
        "id": "builderData",
        "title": "Response Structure",
        "type": "response-format",
        "condition": {
          "field": "dataMode",
          "value": "structured"
        }
      },
      {
        "id": "data",
        "title": "Response Data",
        "type": "code",
        "placeholder": "{\n  \"message\": \"Hello world\"\n}",
        "language": "json",
        "condition": {
          "field": "dataMode",
          "value": "json"
        }
      },
      {
        "id": "status",
        "title": "Status Code",
        "type": "short-input",
        "placeholder": "200"
      },
      {
        "id": "headers",
        "title": "Response Headers",
        "type": "table"
      }
    ],
    "tools": {
      "access": [],
      "config": {
        "tool": ""
      }
    },
    "inputs": {
      "dataMode": {
        "type": "string",
        "description": "Response data definition mode"
      },
      "builderData": {
        "type": "json",
        "description": "Structured response data"
      },
      "data": {
        "type": "json",
        "description": "JSON response body"
      },
      "status": {
        "type": "number",
        "description": "HTTP status code"
      },
      "headers": {
        "type": "json",
        "description": "Response headers"
      }
    },
    "outputs": {
      "data": {
        "type": "json",
        "description": "Response data"
      },
      "status": {
        "type": "number",
        "description": "HTTP status code"
      },
      "headers": {
        "type": "json",
        "description": "Response headers"
      }
    }
  },
  "tools": [
    {
      "id": "response_execute",
      "name": "response execute",
      "description": "",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "response",
        "operation": "execute"
      }
    }
  ]
}