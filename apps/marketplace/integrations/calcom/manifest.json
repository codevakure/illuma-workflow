      },
      {
        "id": "reschedulingReason",
        "type": "long-input",
        "title": "Rescheduling Reason",
        "placeholder": "Reason for rescheduling",
        "mode": "advanced"
      },
      {
        "id": "bookingStatus",
        "type": "dropdown",
        "title": "Status",
        "options": [
          {
            "label": "Upcoming",
            "value": "upcoming"
          },
          {
            "label": "Recurring",
            "value": "recurring"
          },
          {
            "label": "Past",
            "value": "past"
          },
          {
            "label": "Cancelled",
            "value": "cancelled"
          },
          {
            "label": "Unconfirmed",
            "value": "unconfirmed"
          }
        ]
      },
      {
        "id": "eventTypeIdParam",
        "type": "short-input",
        "title": "Event Type ID",
        "placeholder": "Enter event type ID"
      },
      {
        "id": "title",
        "type": "short-input",
        "title": "Title",
        "placeholder": "Event type title"
      },
      {
        "id": "slug",
        "type": "short-input",
        "title": "Slug",
        "placeholder": "URL-friendly identifier (e.g., 30-min-meeting)"
      },
      {
        "id": "eventLength",
        "type": "short-input",
        "title": "Duration (minutes)",
        "placeholder": "Event duration in minutes (e.g., 30)"
      },
      {
        "id": "description",
        "type": "long-input",
        "title": "Description",
        "placeholder": "Event type description",
        "mode": "advanced"
      },
      {
        "id": "slotInterval",
        "type": "short-input",
        "title": "Slot Interval (minutes)",
        "placeholder": "Minutes between available slots",
        "mode": "advanced"
      },
      {
        "id": "minimumBookingNotice",
        "type": "short-input",
        "title": "Minimum Notice (minutes)",
        "placeholder": "Minimum advance notice required",
        "mode": "advanced"
      },
      {
        "id": "beforeEventBuffer",
        "type": "short-input",
        "title": "Buffer Before (minutes)",
        "placeholder": "Buffer time before event",
        "mode": "advanced"
      },
      {
        "id": "afterEventBuffer",
        "type": "short-input",
        "title": "Buffer After (minutes)",
        "placeholder": "Buffer time after event",
        "mode": "advanced"
      },
      {
        "id": "eventTypeScheduleId",
        "type": "short-input",
        "title": "Schedule ID",
        "placeholder": "Assign to a specific schedule",
        "mode": "advanced"
      },
      {
        "id": "disableGuests",
        "type": "switch",
        "title": "Disable Guests",
        "mode": "advanced"
      },
      {
        "id": "scheduleId",
        "type": "short-input",
        "title": "Schedule ID",
        "placeholder": "Enter schedule ID"
      },
      {
        "id": "name",
        "type": "short-input",
        "title": "Name",
        "placeholder": "Schedule name (e.g., Working Hours)"
      },
      {
        "id": "timeZone",
        "type": "short-input",
        "title": "Time Zone",
        "placeholder": "e.g., America/New_York"
      },
      {
        "id": "isDefault",
        "type": "switch",
        "title": "Default Schedule"
      },
      {
        "id": "availability",
        "type": "code",
        "title": "Availability",
        "placeholder": "[\n  {\n    "
      },
      {
        "id": "eventTypeSlug",
        "type": "short-input",
        "title": "Event Type Slug",
        "placeholder": "Event type slug (alternative to ID)",
        "mode": "advanced"
      },
      {
        "id": "username",
        "type": "short-input",
        "title": "Username",
        "placeholder": "Cal.com username (required with slug)",
        "mode": "advanced"
      },
      {
        "id": "duration",
        "type": "short-input",
        "title": "Duration (minutes)",
        "placeholder": "Slot duration in minutes",
        "mode": "advanced"
      },
      {
        "id": "sortCreatedAt",
        "type": "dropdown",
        "title": "Sort by Created",
        "mode": "advanced",
        "options": [
          {
            "label": "Ascending",
            "value": "asc"
          },
          {
            "label": "Descending",
            "value": "desc"
          }
        ]
      },
      {
        "id": "webhookUrlDisplay",
        "type": "short-input",
        "title": "Webhook URL",
        "readOnly": true,
        "showCopyButton": true,
        "useWebhookUrl": true,
        "placeholder": "Webhook URL will be generated",
        "mode": "trigger"
      },
      {
        "id": "signingKey",
        "type": "short-input",
        "title": "Signing Key",
        "placeholder": "Enter your Cal.com webhook signing key",
        "password": true,
        "required": false,
        "mode": "trigger"
      },
      {
        "id": "triggerSave",
        "type": "trigger-save",
        "title": "",
        "hideFromPreview": true,
        "mode": "trigger",
        "triggerId": "calcom_webhook"
      },
      {
        "id": "triggerInstructions",
        "type": "text",
        "title": "Setup Instructions",
        "hideFromPreview": true,
        "mode": "trigger",
        "default": "<div class='mb-3'><strong>1.</strong> Go to Cal.com Settings > Developer > Webhooks.</div><div class='mb-3'><strong>2.</strong> Create a new webhook and paste the Webhook URL above.</div><div class='mb-3'><strong>3.</strong> Select the events you want to trigger on.</div><div class='mb-3'><strong>4.</strong> Optionally add a signing key for security.</div>"
      }
    ],
    "tools": {
      "access": [
        "calcom_create_booking",
        "calcom_get_booking",
        "calcom_list_bookings",
        "calcom_cancel_booking",
        "calcom_reschedule_booking",
        "calcom_confirm_booking",
        "calcom_decline_booking",
        "calcom_create_event_type",
        "calcom_get_event_type",
        "calcom_list_event_types",
        "calcom_update_event_type",
        "calcom_delete_event_type",
        "calcom_create_schedule",
        "calcom_get_schedule",
        "calcom_list_schedules",
        "calcom_update_schedule",
        "calcom_delete_schedule",
        "calcom_get_default_schedule",
        "calcom_get_slots"
      ],
      "config": {
        "tool": "{{operation}}"
      }
    },
    "inputs": {
      "operation": {
        "type": "string"
      }
    },
    "outputs": {
      "success": {
        "type": "boolean"
      }
    },
    "triggers": {
      "enabled": true,
      "available": ["calcom_webhook", "calcom_booking_created", "calcom_booking_cancelled", "calcom_booking_rescheduled", "calcom_booking_requested", "calcom_booking_rejected", "calcom_booking_paid", "calcom_meeting_ended", "calcom_recording_ready"]
    },
    "triggerAllowed": true
  },
