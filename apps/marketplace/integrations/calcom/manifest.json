{
  "id": "calcom",
  "name": "Cal Com",
  "version": "1.0.0",
  "description": "Manage Cal.com bookings, event types, schedules, and availability",
  "icon": "CalComIcon",
  "block": {
    "type": "calcom",
    "name": "Cal Com",
    "description": "Manage Cal.com bookings, event types, schedules, and availability",
    "longDescription": "Integrate Cal.com into your workflow. Create and manage bookings, event types, schedules, and check availability slots. Supports creating, listing, rescheduling, and canceling bookings, as well as managing event types and schedules. Can also trigger workflows based on Cal.com webhook events (booking created, cancelled, rescheduled). Connect your Cal.com account via OAuth.",
    "docsLink": "https://docs.sim.ai/tools/calcom",
    "category": "tools",
    "bgColor": "#FFFFFE",
    "icon": "CalComIcon",
    "authMode": "oauth",
    "subBlocks": [
      {
        "id": "selectedTriggerId",
        "type": "dropdown",
        "title": "Trigger Event",
        "mode": "trigger"
      },
      {
        "id": "operation",
        "type": "dropdown",
        "title": "Operation",
        "options": [
          {
            "label": "List Bookings",
            "value": "calcom_list_bookings"
          },
          {
            "label": "Create Booking",
            "value": "calcom_create_booking"
          },
          {
            "label": "Get Booking",
            "value": "calcom_get_booking"
          },
          {
            "label": "Cancel Booking",
            "value": "calcom_cancel_booking"
          },
          {
            "label": "Reschedule Booking",
            "value": "calcom_reschedule_booking"
          },
          {
            "label": "Confirm Booking",
            "value": "calcom_confirm_booking"
          },
          {
            "label": "Decline Booking",
            "value": "calcom_decline_booking"
          },
          {
            "label": "Create Event Type",
            "value": "calcom_create_event_type"
          },
          {
            "label": "Get Event Type",
            "value": "calcom_get_event_type"
          },
          {
            "label": "List Event Types",
            "value": "calcom_list_event_types"
          },
          {
            "label": "Update Event Type",
            "value": "calcom_update_event_type"
          },
          {
            "label": "Delete Event Type",
            "value": "calcom_delete_event_type"
          },
          {
            "label": "Create Schedule",
            "value": "calcom_create_schedule"
          },
          {
            "label": "Get Schedule",
            "value": "calcom_get_schedule"
          },
          {
            "label": "List Schedules",
            "value": "calcom_list_schedules"
          },
          {
            "label": "Update Schedule",
            "value": "calcom_update_schedule"
          },
          {
            "label": "Delete Schedule",
            "value": "calcom_delete_schedule"
          },
          {
            "label": "Get Default Schedule",
            "value": "calcom_get_default_schedule"
          },
          {
            "label": "Get Available Slots",
            "value": "calcom_get_slots"
          }
        ]
      },
      {
        "id": "credential",
