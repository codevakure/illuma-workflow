  "triggers": [
    { "id": "calcom_booking_created", "name": "Cal.com Booking Created", "provider": "calcom", "description": "Trigger when a booking is created", "version": "1.0.0", "webhook": { "method": "POST" }, "credentials": [{ "id": "secret", "label": "Webhook Secret", "type": "password", "required": false, "description": "Secret for HMAC signature verification", "placeholder": "Enter webhook secret" }], "auth": { "type": "hmac", "headerName": "X-Cal-Signature-256", "secretField": "secret", "algorithm": "sha256", "encoding": "hex" }, "outputs": { "triggerEvent": { "type": "string", "description": "Event type (BOOKING_CREATED)" }, "createdAt": { "type": "string", "description": "Event timestamp (ISO 8601)" }, "payload": { "type": "object", "description": "Booking data (title, description, startTime, endTime, uid, status, organizer, attendees, responses, metadata)" } } },
    { "id": "calcom_booking_cancelled", "name": "Cal.com Booking Cancelled", "provider": "calcom", "description": "Trigger when a booking is cancelled", "version": "1.0.0", "webhook": { "method": "POST" }, "credentials": [{ "id": "secret", "label": "Webhook Secret", "type": "password", "required": false, "description": "Secret for HMAC signature verification", "placeholder": "Enter webhook secret" }], "auth": { "type": "hmac", "headerName": "X-Cal-Signature-256", "secretField": "secret", "algorithm": "sha256", "encoding": "hex" }, "outputs": { "triggerEvent": { "type": "string", "description": "Event type (BOOKING_CANCELLED)" }, "createdAt": { "type": "string", "description": "Event timestamp" }, "payload": { "type": "object", "description": "Booking data with cancellationReason" } } },
    { "id": "calcom_booking_rescheduled", "name": "Cal.com Booking Rescheduled", "provider": "calcom", "description": "Trigger when a booking is rescheduled", "version": "1.0.0", "webhook": { "method": "POST" }, "credentials": [{ "id": "secret", "label": "Webhook Secret", "type": "password", "required": false, "description": "Secret for HMAC signature verification", "placeholder": "Enter webhook secret" }], "auth": { "type": "hmac", "headerName": "X-Cal-Signature-256", "secretField": "secret", "algorithm": "sha256", "encoding": "hex" }, "outputs": { "triggerEvent": { "type": "string", "description": "Event type (BOOKING_RESCHEDULED)" }, "createdAt": { "type": "string", "description": "Event timestamp" }, "payload": { "type": "object", "description": "Booking data with rescheduleId, rescheduleUid, rescheduleStartTime, rescheduleEndTime" } } },
    { "id": "calcom_booking_requested", "name": "Cal.com Booking Requested", "provider": "calcom", "description": "Trigger when a booking is requested", "version": "1.0.0", "webhook": { "method": "POST" }, "credentials": [{ "id": "secret", "label": "Webhook Secret", "type": "password", "required": false, "description": "Secret for HMAC signature verification", "placeholder": "Enter webhook secret" }], "auth": { "type": "hmac", "headerName": "X-Cal-Signature-256", "secretField": "secret", "algorithm": "sha256", "encoding": "hex" }, "outputs": { "triggerEvent": { "type": "string", "description": "Event type (BOOKING_REQUESTED)" }, "createdAt": { "type": "string", "description": "Event timestamp" }, "payload": { "type": "object", "description": "Booking data" } } },
    { "id": "calcom_booking_rejected", "name": "Cal.com Booking Rejected", "provider": "calcom", "description": "Trigger when a booking is rejected", "version": "1.0.0", "webhook": { "method": "POST" }, "credentials": [{ "id": "secret", "label": "Webhook Secret", "type": "password", "required": false, "description": "Secret for HMAC signature verification", "placeholder": "Enter webhook secret" }], "auth": { "type": "hmac", "headerName": "X-Cal-Signature-256", "secretField": "secret", "algorithm": "sha256", "encoding": "hex" }, "outputs": { "triggerEvent": { "type": "string", "description": "Event type (BOOKING_REJECTED)" }, "createdAt": { "type": "string", "description": "Event timestamp" }, "payload": { "type": "object", "description": "Booking data" } } },
