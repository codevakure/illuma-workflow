        "placeholder": "Select Cal.com account",
        "serviceId": "calcom"
      },
      {
        "id": "eventTypeId",
        "type": "short-input",
        "title": "Event Type ID",
        "placeholder": "Enter event type ID (number)"
      },
      {
        "id": "start",
        "type": "short-input",
        "title": "Start Time",
        "placeholder": "ISO 8601 format (e.g., 2024-01-15T10:00:00Z)"
      },
      {
        "id": "end",
        "type": "short-input",
        "title": "End Time",
        "placeholder": "ISO 8601 format (e.g., 2024-01-15T11:00:00Z)"
      },
      {
        "id": "attendeeName",
        "type": "short-input",
        "title": "Attendee Name",
        "placeholder": "Enter attendee name"
      },
      {
        "id": "attendeeEmail",
        "type": "short-input",
        "title": "Attendee Email",
        "placeholder": "Enter attendee email"
      },
      {
        "id": "attendeeTimeZone",
        "type": "short-input",
        "title": "Attendee Time Zone",
