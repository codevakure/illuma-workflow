      },
      {
        "id": "guests",
        "type": "short-input",
        "title": "Guests",
        "placeholder": "Comma-separated email addresses",
        "mode": "advanced"
      },
      {
        "id": "lengthInMinutes",
        "type": "short-input",
        "title": "Duration (minutes)",
        "placeholder": "Override default event duration",
        "mode": "advanced"
      },
      {
        "id": "metadata",
