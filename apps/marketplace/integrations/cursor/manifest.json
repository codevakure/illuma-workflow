{
  "id": "cursor",
  "name": "Cursor",
  "version": "1.0.0",
  "description": "Launch and manage Cursor cloud agents to work on GitHub repositories",
  "icon": "CursorIcon",
  "block": {
    "type": "cursor",
    "name": "Cursor",
    "description": "Launch and manage Cursor cloud agents to work on GitHub repositories",
    "longDescription": "Interact with Cursor Cloud Agents API to launch AI agents that can work on your GitHub repositories. Supports launching agents, adding follow-up instructions, checking status, viewing conversations, and managing agent lifecycle.",
    "docsLink": "https://cursor.com/docs/cloud-agent/api/endpoints",
    "category": "tools",
    "bgColor": "#1E1E1E",
    "icon": "CursorIcon",
    "authMode": "api_key",
    "hideFromToolbar": false,
    "subBlocks": [
      {
        "id": "operation",
        "type": "dropdown",
        "title": "Operation",
        "options": [
          {
            "label": "Launch Agent",
            "value": "cursor_launch_agent"
          },
          {
            "label": "Add Follow-up",
            "value": "cursor_add_followup"
          },
          {
            "label": "Get Agent Status",
            "value": "cursor_get_agent"
          },
          {
            "label": "Get Conversation",
            "value": "cursor_get_conversation"
          },
          {
            "label": "List Agents",
            "value": "cursor_list_agents"
          },
          {
            "label": "Stop Agent",
            "value": "cursor_stop_agent"
          },
          {
            "label": "Delete Agent",
            "value": "cursor_delete_agent"
          }
        ]
      },
      {
        "id": "repository",
        "type": "short-input",
        "title": "Repository URL",
        "placeholder": "https://github.com/your-org/your-repo"
      },
      {
        "id": "ref",
        "type": "short-input",
        "title": "Branch/Ref",
        "placeholder": "main (optional)"
      },
      {
        "id": "promptText",
        "type": "long-input",
        "title": "Prompt",
        "placeholder": "Describe the task for the agent..."
      },
      {
        "id": "model",
        "type": "short-input",
        "title": "Model",
        "placeholder": "Auto-selection by default"
      },
      {
        "id": "branchName",
        "type": "short-input",
        "title": "Branch Name",
        "placeholder": "Custom branch name (optional)"
      },
      {
        "id": "autoCreatePr",
        "type": "switch",
        "title": "Auto Create PR"
      },
      {
        "id": "openAsCursorGithubApp",
        "type": "switch",
        "title": "Open as Cursor GitHub App"
      },
      {
        "id": "skipReviewerRequest",
        "type": "switch",
        "title": "Skip Reviewer Request"
      },
      {
        "id": "agentId",
        "type": "short-input",
        "title": "Agent ID",
        "placeholder": "e.g., bc_abc123"
      },
      {
        "id": "followupPromptText",
        "type": "long-input",
        "title": "Follow-up Prompt",
        "placeholder": "Additional instructions for the agent..."
      },
      {
        "id": "limit",
        "type": "short-input",
        "title": "Limit",
        "placeholder": "20 (default, max 100)"
      },
      {
        "id": "cursor",
        "type": "short-input",
        "title": "Pagination Cursor",
        "placeholder": "Cursor from previous response"
      },
      {
        "id": "apiKey",
        "type": "short-input",
        "title": "API Key",
        "placeholder": "Enter Cursor API Key",
        "password": true
      }
    ],
    "tools": {
      "access": [
        "cursor_list_agents",
        "cursor_get_agent",
        "cursor_get_conversation",
        "cursor_launch_agent",
        "cursor_add_followup",
        "cursor_stop_agent",
        "cursor_delete_agent"
      ],
      "config": {
        "tool": "{{operation}}"
      }
    },
    "inputs": {
      "operation": {
        "type": "string"
      }
    },
    "outputs": {
      "content": {
        "type": "string"
      }
    }
  },
  "tools": [
    {
      "id": "cursor_add_followup",
      "name": "Cursor Add Follow-up",
      "description": "Cursor API key",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "cursor",
        "operation": "cursor_add_followup"
      }
    },
    {
      "id": "cursor_delete_agent",
      "name": "Cursor Delete Agent",
      "description": "Cursor API key",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "cursor",
        "operation": "cursor_delete_agent"
      }
    },
    {
      "id": "cursor_get_agent",
      "name": "Cursor Get Agent",
      "description": "Cursor API key",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "cursor",
        "operation": "cursor_get_agent"
      }
    },
    {
      "id": "cursor_get_conversation",
      "name": "Cursor Get Conversation",
      "description": "Cursor API key",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "cursor",
        "operation": "cursor_get_conversation"
      }
    },
    {
      "id": "cursor_launch_agent",
      "name": "Cursor Launch Agent",
      "description": "Cursor API key",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "cursor",
        "operation": "cursor_launch_agent"
      }
    },
    {
      "id": "cursor_list_agents",
      "name": "Cursor List Agents",
      "description": "Cursor API key",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "cursor",
        "operation": "cursor_list_agents"
      }
    },
    {
      "id": "cursor_stop_agent",
      "name": "Cursor Stop Agent",
      "description": "Cursor API key",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "cursor",
        "operation": "cursor_stop_agent"
      }
    }
  ]
}
