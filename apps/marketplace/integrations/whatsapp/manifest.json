{
  "id": "whatsapp",
  "name": "WhatsApp",
  "version": "1.0.0",
  "description": "Send WhatsApp messages",
  "icon": "WhatsAppIcon",
  "block": {
    "type": "whatsapp",
    "name": "WhatsApp",
    "description": "Send WhatsApp messages",
    "longDescription": "Integrate WhatsApp into the workflow. Can send messages.",
    "docsLink": "https://docs.sim.ai/tools/whatsapp",
    "category": "tools",
    "bgColor": "#25D366",
    "icon": "WhatsAppIcon",
    "authMode": "api_key",
    "subBlocks": [
      {
        "id": "phoneNumber",
        "type": "short-input",
        "title": "Recipient Phone Number",
        "placeholder": "Enter phone number with country code (e.g., +1234567890)"
      },
      {
        "id": "message",
        "type": "long-input",
        "title": "Message",
        "placeholder": "Enter your message"
      },
      {
        "id": "phoneNumberId",
        "type": "short-input",
        "title": "WhatsApp Phone Number ID",
        "placeholder": "Your WhatsApp Business Phone Number ID"
      },
      {
        "id": "accessToken",
        "type": "short-input",
        "title": "Access Token",
        "placeholder": "Your WhatsApp Business API Access Token",
        "password": true
      },
      {
        "id": "webhookUrlDisplay",
        "type": "short-input",
        "title": "Webhook URL",
        "readOnly": true,
        "showCopyButton": true,
        "useWebhookUrl": true,
        "placeholder": "Webhook URL will be generated",
        "mode": "trigger"
      },
      {
        "id": "verificationToken",
        "type": "short-input",
        "title": "Verification Token",
        "placeholder": "Generate or enter a verification token",
        "description": "Enter any secure token here. You'll need to provide the same token in your WhatsApp Business Platform dashboard.",
        "password": true,
        "required": true,
        "mode": "trigger"
      },
      {
        "id": "triggerSave",
        "type": "trigger-save",
        "title": "",
        "hideFromPreview": true,
        "mode": "trigger",
        "triggerId": "whatsapp_webhook"
      },
      {
        "id": "triggerInstructions",
        "type": "text",
        "title": "Setup Instructions",
        "hideFromPreview": true,
        "mode": "trigger",
        "default": "<div class='mb-3'><strong>1.</strong> Go to your Meta for Developers Apps page and navigate to WhatsApp > Configuration.</div><div class='mb-3'><strong>2.</strong> Find the Webhooks section and click Edit.</div><div class='mb-3'><strong>3.</strong> Paste the Webhook URL above into the Callback URL field.</div><div class='mb-3'><strong>4.</strong> Paste the Verification Token into the Verify token field.</div><div class='mb-3'><strong>5.</strong> Click Verify and save.</div><div class='mb-3'><strong>6.</strong> Subscribe to the messages webhook field.</div>"
      }
    ],
    "tools": {
      "access": [
        "whatsapp_send_message"
      ],
      "config": {
        "tool": "whatsapp_send_message"
      }
    },
    "inputs": {
      "phoneNumber": {
        "type": "string"
      }
    },
    "outputs": {
      "success": {
        "type": "boolean"
      }
    },
    "triggers": {
      "enabled": true,
      "available": ["whatsapp_webhook"]
    },
    "triggerAllowed": true
  },
  "tools": [
    {
      "id": "whatsapp_send_message",
      "name": "WhatsApp",
      "description": "Send WhatsApp messages",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "whatsapp",
        "operation": "whatsapp_send_message"
      }
    }
  ]
}
