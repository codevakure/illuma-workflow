    "tools": {
      "access": [
        "jira_retrieve",
        "jira_update",
        "jira_write",
        "jira_bulk_read",
        "jira_delete_issue",
        "jira_assign_issue",
        "jira_transition_issue",
        "jira_search_issues",
        "jira_add_comment",
        "jira_get_comments",
        "jira_update_comment",
        "jira_delete_comment",
        "jira_get_attachments",
        "jira_add_attachment",
        "jira_delete_attachment",
        "jira_add_worklog",
        "jira_get_worklogs",
        "jira_update_worklog",
        "jira_delete_worklog",
        "jira_create_issue_link",
        "jira_delete_issue_link",
        "jira_add_watcher",
        "jira_remove_watcher",
        "jira_get_users"
