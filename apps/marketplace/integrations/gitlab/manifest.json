    {
      "id": "gitlab_update_issue",
      "name": "GitLab Update Issue",
      "description": "Update an existing issue in a GitLab project",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "gitlab",
        "operation": "gitlab_update_issue"
