    {
      "id": "stt_whisper",
      "name": "OpenAI Whisper STT",
      "description": "Transcribe audio to text using OpenAI Whisper",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "stt",
        "operation": "stt_whisper"
      }
