            "label": "Polish",
            "value": "pl"
          },
          {
            "label": "Turkish",
            "value": "tr"
          },
          {
            "label": "Swedish",
            "value": "sv"
          },
          {
            "label": "Danish",
            "value": "da"
          },
          {
            "label": "Norwegian",
            "value": "no"
          },
          {
            "label": "Finnish",
            "value": "fi"
          }
        ]
      },
      {
        "id": "timestamps",
        "type": "dropdown",
        "title": "Timestamps",
        "options": [
          {
            "label": "None",
            "value": "none"
          },
          {
            "label": "Sentence-level",
            "value": "sentence"
          },
          {
            "label": "Word-level",
            "value": "word"
          }
        ]
      },
      {
        "id": "diarization",
        "type": "switch",
        "title": "Speaker Diarization"
      },
      {
        "id": "translateToEnglish",
        "type": "switch",
        "title": "Translate to English"
      },
      {
        "id": "sentiment",
        "type": "switch",
        "title": "Sentiment Analysis"
      },
      {
        "id": "entityDetection",
        "type": "switch",
        "title": "Entity Detection"
      },
      {
        "id": "piiRedaction",
        "type": "switch",
        "title": "PII Redaction"
      },
      {
        "id": "summarization",
        "type": "switch",
        "title": "Auto Summarization"
      },
      {
        "id": "apiKey",
        "type": "short-input",
        "title": "API Key",
        "placeholder": "Enter your API key",
        "password": true
      }
    ],
    "tools": {
      "access": [
        "stt_whisper",
        "stt_deepgram",
        "stt_elevenlabs",
        "stt_assemblyai",
        "stt_gemini"
      ],
      "config": {
        "tool": "{{operation}}"
      }
    },
    "inputs": {
      "provider": {
        "type": "string"
      }
    },
    "outputs": {
      "transcript": {
        "type": "string"
      }
    }
  },
  "tools": [
    {
      "id": "stt_assemblyai",
      "name": "AssemblyAI STT",
      "description": "Transcribe audio to text using AssemblyAI with advanced NLP features",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "stt",
        "operation": "stt_assemblyai"
      }
    },
    {
      "id": "stt_deepgram",
      "name": "Deepgram STT",
      "description": "Transcribe audio to text using Deepgram",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "stt",
        "operation": "stt_deepgram"
      }
    },
    {
      "id": "stt_elevenlabs",
      "name": "ElevenLabs STT",
