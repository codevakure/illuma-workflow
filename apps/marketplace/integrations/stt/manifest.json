{
  "id": "stt",
  "name": "Speech-to-Text",
  "version": "1.0.0",
  "description": "Convert speech to text using AI",
  "icon": "STTIcon",
  "block": {
    "type": "stt",
    "name": "Speech-to-Text",
    "description": "Convert speech to text using AI",
    "longDescription": "Transcribe audio and video files to text using leading AI providers. Supports multiple languages, timestamps, and speaker diarization.",
    "docsLink": "https://docs.sim.ai/tools/stt",
    "category": "tools",
    "bgColor": "#181C1E",
    "icon": "STTIcon",
    "authMode": "api_key",
    "hideFromToolbar": false,
    "subBlocks": [
      {
        "id": "provider",
        "type": "dropdown",
        "title": "Provider",
        "options": [
          {
            "label": "OpenAI Whisper",
            "value": "whisper"
          },
          {
            "label": "Deepgram",
            "value": "deepgram"
          },
          {
            "label": "ElevenLabs",
            "value": "elevenlabs"
          },
          {
            "label": "AssemblyAI",
            "value": "assemblyai"
          },
          {
            "label": "Google Gemini",
            "value": "gemini"
          }
        ]
      },
      {
        "id": "model",
        "type": "dropdown",
        "title": "Model",
        "options": [
          {
            "label": "Whisper-1",
            "value": "whisper-1"
          }
        ]
      },
      {
        "id": "model",
        "type": "dropdown",
        "title": "Model",
        "options": [
          {
            "label": "Scribe v1",
            "value": "scribe_v1"
          },
          {
            "label": "Scribe v1 Experimental",
            "value": "scribe_v1_experimental"
          }
        ]
      },
      {
        "id": "model",
        "type": "dropdown",
        "title": "Model",
        "options": [
          {
            "label": "Nova 3",
            "value": "nova-3"
          },
          {
            "label": "Nova 2",
            "value": "nova-2"
          },
          {
            "label": "Nova",
            "value": "nova"
          },
          {
            "label": "Whisper Large",
            "value": "whisper-large"
          },
          {
            "label": "Enhanced",
            "value": "enhanced"
          },
          {
            "label": "Base",
            "value": "base"
          }
        ]
      },
      {
        "id": "model",
        "type": "dropdown",
        "title": "Model",
        "options": [
          {
            "label": "Best",
            "value": "best"
          }
        ]
      },
      {
        "id": "model",
        "type": "dropdown",
        "title": "Model",
        "options": [
          {
            "label": "Gemini 3 Pro",
            "value": "gemini-3-pro-preview"
          },
          {
            "label": "Gemini 2.5 Pro",
            "value": "gemini-2.5-pro"
          },
          {
            "label": "Gemini 2.5 Flash",
            "value": "gemini-2.5-flash"
          },
          {
            "label": "Gemini 2.5 Flash Lite",
            "value": "gemini-2.5-flash-lite"
          },
          {
            "label": "Gemini 2.0 Flash",
            "value": "gemini-2.0-flash-exp"
          }
        ]
      },
      {
        "id": "audioFile",
        "type": "file-upload",
        "title": "Audio/Video File",
        "placeholder": "Upload an audio or video file",
        "mode": "basic",
        "canonicalParamId": "audioFile"
      },
      {
        "id": "audioFileReference",
        "type": "short-input",
        "title": "Audio/Video File Reference",
        "placeholder": "Reference audio/video from previous blocks",
        "mode": "advanced",
        "canonicalParamId": "audioFile"
      },
      {
        "id": "audioUrl",
        "type": "short-input",
        "title": "Audio/Video URL",
        "placeholder": "Or enter publicly accessible audio/video URL"
      },
      {
        "id": "language",
        "type": "dropdown",
        "title": "Language",
        "options": [
          {
            "label": "Auto-detect",
            "value": "auto"
          },
          {
            "label": "English",
            "value": "en"
          },
          {
            "label": "Spanish",
            "value": "es"
          },
          {
            "label": "French",
