{
  "id": "rss",
  "name": "RSS Feed",
  "version": "1.0.0",
  "description": "Monitor RSS feeds and trigger workflows when new items are published",
  "icon": "RssIcon",
  "block": {
    "type": "rss",
    "name": "RSS Feed",
    "description": "Monitor RSS feeds and trigger workflows when new items are published",
    "longDescription": "Subscribe to any RSS or Atom feed and automatically trigger your workflow when new content is published. Perfect for monitoring blogs, news sites, podcasts, and any content that publishes an RSS feed.",
    "docsLink": "https://docs.sim.ai/triggers/rss",
    "category": "triggers",
    "bgColor": "#F97316",
    "icon": "RssIcon",
    "triggerAllowed": true,
    "subBlocks": [
      {
        "id": "feedUrl",
        "type": "short-input",
        "title": "Feed URL",
        "placeholder": "https://example.com/feed.xml",
        "description": "The URL of the RSS or Atom feed to monitor",
        "required": true,
        "mode": "trigger"
      },
      {
        "id": "triggerSave",
        "type": "trigger-save",
        "title": "",
        "hideFromPreview": true,
        "mode": "trigger",
        "triggerId": "rss_poller"
      },
      {
        "id": "triggerInstructions",
        "type": "text",
        "title": "Setup Instructions",
        "hideFromPreview": true,
        "mode": "trigger",
        "default": "<div class='mb-3'><strong>1.</strong> Enter the URL of any RSS or Atom feed you want to monitor</div><div class='mb-3'><strong>2.</strong> The feed will be checked every minute for new items</div><div class='mb-3'><strong>3.</strong> When a new item is published, your workflow will be triggered with the item data</div>"
      }
    ],
    "tools": {
      "access": [],
      "config": {
        "tool": ""
      }
    },
    "inputs": {},
    "outputs": {
      "title": {
        "type": "string",
        "description": "Item title"
      },
      "link": {
        "type": "string",
        "description": "Item link"
      },
      "pubDate": {
        "type": "string",
        "description": "Publication date"
      },
      "item": {
        "type": "json",
        "description": "Raw item object with all fields"
      },
      "feed": {
        "type": "json",
        "description": "Raw feed object with all fields"
      }
    },
    "triggers": {
      "enabled": true,
      "available": [
        "rss_poller"
      ]
    }
  },
  "tools": [
    {
      "id": "rss_execute",
      "name": "rss execute",
      "description": "",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "rss",
        "operation": "execute"
      }
    }
  ],
  "triggers": [
    {
      "id": "rss_poller",
      "name": "RSS Feed",
      "provider": "rss",
      "description": "Trigger workflow when new items appear in an RSS feed",
      "version": "1.0.0",
      "credentials": [],
      "outputs": {
        "item": {
          "type": "object",
          "description": "RSS feed item",
          "properties": {
            "title": { "type": "string", "description": "Item title" },
            "link": { "type": "string", "description": "Item URL" },
            "pubDate": { "type": "string", "description": "Publication date" },
            "guid": { "type": "string", "description": "Unique identifier" },
            "summary": { "type": "string", "description": "Item summary" },
            "content": { "type": "string", "description": "Full content" },
            "author": { "type": "string", "description": "Item author" },
            "categories": { "type": "array", "description": "Item categories" }
          }
        },
        "feed": {
          "type": "object",
          "description": "Feed metadata",
          "properties": {
            "title": { "type": "string", "description": "Feed title" },
            "link": { "type": "string", "description": "Feed URL" },
            "feedDescription": { "type": "string", "description": "Feed description" }
          }
        },
        "timestamp": { "type": "string", "description": "Event timestamp" }
      }
    }
  ]
}