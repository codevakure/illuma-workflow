{
  "id": "textract",
  "name": "AWS Textract",
  "version": "1.0.0",
  "description": "Extract text, tables, and forms from documents",
  "icon": "TextractIcon",
  "block": {
    "type": "textract",
    "name": "AWS Textract",
    "description": "Extract text, tables, and forms from documents",
    "longDescription": "Integrate AWS Textract into your workflow to extract text, tables, forms, and key-value pairs from documents. Single-page mode supports JPEG, PNG, and single-page PDF. Multi-page mode supports multi-page PDF and TIFF.",
    "docsLink": "https://docs.sim.ai/tools/textract",
    "category": "tools",
    "bgColor": "linear-gradient(135deg, #055F4E 0%, #56C0A7 100%)",
    "icon": "TextractIcon",
    "authMode": "api_key",
    "hideFromToolbar": true,
    "subBlocks": [
      {
        "id": "processingMode",
        "type": "dropdown",
        "title": "Processing Mode",
        "options": [
          {
            "label": "sync",
            "value": "sync"
          },
          {
            "label": "async",
            "value": "async"
          }
        ]
      },
      {
        "id": "fileUpload",
        "type": "file-upload",
        "title": "Document",
        "placeholder": "Upload JPEG, PNG, or single-page PDF (max 10MB)",
        "mode": "basic",
        "canonicalParamId": "document"
      },
      {
        "id": "filePath",
        "type": "short-input",
        "title": "Document",
        "placeholder": "URL to JPEG, PNG, or single-page PDF",
        "mode": "advanced",
        "canonicalParamId": "document"
      },
      {
        "id": "s3Uri",
        "type": "short-input",
        "title": "S3 URI",
        "placeholder": "s3://bucket-name/path/to/document.pdf"
      },
      {
        "id": "region",
        "type": "short-input",
        "title": "AWS Region",
        "placeholder": "e.g., us-east-1"
      },
      {
        "id": "accessKeyId",
        "type": "short-input",
        "title": "AWS Access Key ID",
        "placeholder": "Enter your AWS Access Key ID",
        "password": true
      },
      {
        "id": "secretAccessKey",
        "type": "short-input",
        "title": "AWS Secret Access Key",
        "placeholder": "Enter your AWS Secret Access Key",
        "password": true
      },
      {
        "id": "extractTables",
        "type": "switch",
        "title": "Extract Tables"
      },
      {
        "id": "extractForms",
        "type": "switch",
        "title": "Extract Forms (Key-Value Pairs)"
      },
      {
        "id": "detectSignatures",
        "type": "switch",
        "title": "Detect Signatures"
      },
      {
        "id": "analyzeLayout",
        "type": "switch",
        "title": "Analyze Document Layout"
      }
    ],
    "tools": {
      "access": [
        "textract_parser"
      ],
      "config": {
        "tool": "textract_parser"
      }
    },
    "inputs": {
      "processingMode": {
        "type": "string"
      }
    },
    "outputs": {
      "blocks": {
        "type": "json"
      }
    }
  },
  "tools": [
    {
      "id": "textract_parser",
      "name": "AWS Textract Parser",
      "description": "Parse documents using AWS Textract OCR and document analysis",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "textract",
        "operation": "textract_parser"
      }
    }
  ]
}
