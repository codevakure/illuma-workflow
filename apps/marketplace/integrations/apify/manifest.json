{
  "id": "apify",
  "name": "Apify",
  "version": "1.0.0",
  "description": "Run Apify actors and retrieve results",
  "icon": "ApifyIcon",
  "block": {
    "type": "apify",
    "name": "Apify",
    "description": "Run Apify actors and retrieve results",
    "longDescription": "Integrate Apify into your workflow. Run any Apify actor with custom input and retrieve results. Supports both synchronous and asynchronous execution with automatic dataset fetching.",
    "docsLink": "https://docs.sim.ai/tools/apify",
    "category": "tools",
    "bgColor": "#E0E0E0",
    "icon": "ApifyIcon",
    "authMode": "api_key",
    "subBlocks": [
      {
        "id": "operation",
        "type": "dropdown",
        "title": "Operation",
        "options": [
          {
            "label": "Run Actor",
            "value": "apify_run_actor_sync"
          },
          {
            "label": "Run Actor (Async)",
            "value": "apify_run_actor_async"
          }
        ]
      },
      {
        "id": "apiKey",
        "type": "short-input",
        "title": "Apify API Token",
        "placeholder": "Enter your Apify API token",
        "password": true
      },
      {
        "id": "actorId",
        "type": "short-input",
        "title": "Actor ID",
        "placeholder": "e.g., janedoe/my-actor or actor ID"
      },
      {
        "id": "input",
        "type": "code",
        "title": "Actor Input",
        "placeholder": "{\\n  "
      },
      {
        "id": "memory",
        "type": "short-input",
        "title": "Memory (MB)",
        "placeholder": "Memory in MB (e.g., 1024 for 1GB, 2048 for 2GB)"
      },
      {
        "id": "timeout",
        "type": "short-input",
        "title": "Timeout",
        "placeholder": "Timeout in seconds (e.g., 300 for 5 min)"
      },
      {
        "id": "build",
        "type": "short-input",
        "title": "Build",
        "placeholder": "Build version (e.g., "
      },
      {
        "id": "waitForFinish",
        "type": "short-input",
        "title": "Wait For Finish",
        "placeholder": "Initial wait time in seconds (0-60)"
      },
      {
        "id": "itemLimit",
        "type": "short-input",
        "title": "Item Limit",
        "placeholder": "Max dataset items to fetch (1-250000)"
      }
    ],
    "tools": {
      "access": [
        "apify_run_actor_sync",
        "apify_run_actor_async"
      ],
      "config": {
        "tool": "{{operation}}"
      }
    },
    "inputs": {
      "operation": {
        "type": "string"
      }
    },
    "outputs": {
      "success": {
        "type": "boolean"
      }
    }
  },
  "tools": [
    {
      "id": "apify_run_actor_async",
      "name": "APIFY Run Actor (Async)",
      "description": "Run an APIFY actor asynchronously with polling for long-running tasks",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "apify",
        "operation": "apify_run_actor_async"
      }
    },
    {
      "id": "apify_run_actor_sync",
      "name": "APIFY Run Actor (Sync)",
      "description": "Run an APIFY actor synchronously and get results (max 5 minutes)",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "apify",
        "operation": "apify_run_actor_sync"
      }
    }
  ]
}
