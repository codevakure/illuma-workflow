{
  "id": "search",
  "name": "Search",
  "version": "1.0.0",
  "description": "Search the web ($0.01 per search)",
  "icon": "SearchIcon",
  "block": {
    "type": "search",
    "name": "Search",
    "description": "Search the web ($0.01 per search)",
    "longDescription": "Search the web using the Search tool. Each search costs $0.01 per query.",
    "docsLink": "https://docs.sim.ai/tools/search",
    "category": "tools",
    "bgColor": "#3B82F6",
    "icon": "SearchIcon",
    "subBlocks": [
      {
        "id": "query",
        "type": "long-input",
        "title": "Search Query",
        "placeholder": "Enter your search query..."
      }
    ],
    "tools": {
      "access": [
        "search_tool"
      ],
      "config": {
        "tool": "search_tool"
      }
    },
    "inputs": {
      "query": {
        "type": "string"
      }
    },
    "outputs": {
      "results": {
        "type": "json"
      }
    }
  },
  "tools": [
    {
      "id": "search_tool",
      "name": "Web Search",
      "description": "Search the web. Returns the most relevant web results, including title, link, snippet, and date for each result.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "search",
        "operation": "search_tool"
      }
    }
  ]
}
