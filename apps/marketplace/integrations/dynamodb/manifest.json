      "version": "1.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "dynamodb",
        "operation": "dynamodb_query"
      }
    },
    {
      "id": "dynamodb_scan",
      "name": "DynamoDB Scan",
      "description": "Scan all items in a DynamoDB table",
      "version": "1.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "dynamodb",
        "operation": "dynamodb_scan"
