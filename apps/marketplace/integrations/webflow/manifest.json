{
  "id": "webflow",
  "name": "Webflow",
  "version": "1.0.0",
  "description": "Manage Webflow CMS collections",
  "icon": "WebflowIcon",
  "block": {
    "type": "webflow",
    "name": "Webflow",
    "description": "Manage Webflow CMS collections",
    "longDescription": "Integrates Webflow CMS into the workflow. Can create, get, list, update, or delete items in Webflow CMS collections. Manage your Webflow content programmatically. Can be used in trigger mode to trigger workflows when collection items change or forms are submitted.",
    "docsLink": "https://docs.sim.ai/tools/webflow",
    "category": "tools",
    "bgColor": "#E0E0E0",
    "icon": "WebflowIcon",
    "authMode": "oauth",
    "subBlocks": [
      {
        "id": "selectedTriggerId",
        "type": "dropdown",
        "title": "Trigger Type",
        "mode": "trigger",
        "required": true,
        "options": [
          { "label": "Collection Item Created", "value": "webflow_collection_item_created" },
          { "label": "Collection Item Changed", "value": "webflow_collection_item_changed" },
          { "label": "Collection Item Deleted", "value": "webflow_collection_item_deleted" },
          { "label": "Form Submission", "value": "webflow_form_submission" }
        ]
      },
      {
        "id": "triggerCredentials",
        "type": "oauth-input",
        "title": "Credentials",
        "required": true,
        "mode": "trigger",
        "serviceId": "webflow",
        "description": "This trigger requires webflow credentials to access your account."
      },
      {
        "id": "triggerSiteId",
        "type": "dropdown",
        "title": "Site",
        "placeholder": "Select a site",
        "required": true,
        "mode": "trigger",
        "options": [],
        "description": "The Webflow site to monitor",
        "dependsOn": ["triggerCredentials"],
        "condition": { "field": "selectedTriggerId", "value": ["webflow_collection_item_created", "webflow_collection_item_changed", "webflow_collection_item_deleted", "webflow_form_submission"] }
      },
      {
        "id": "triggerCollectionId",
        "type": "dropdown",
        "title": "Collection",
        "placeholder": "Select a collection (optional)",
        "required": false,
        "mode": "trigger",
        "options": [],
        "description": "Optionally filter to monitor only a specific collection",
        "dependsOn": ["triggerCredentials", "triggerSiteId"],
        "condition": { "field": "selectedTriggerId", "value": ["webflow_collection_item_created", "webflow_collection_item_changed", "webflow_collection_item_deleted"] }
      },
      {
        "id": "formName",
        "type": "short-input",
        "title": "Form Name",
        "placeholder": "Contact Form (optional)",
        "required": false,
        "mode": "trigger",
        "description": "The name of the specific form to monitor (optional - leave empty for all forms)",
        "condition": { "field": "selectedTriggerId", "value": "webflow_form_submission" }
      },
      {
        "id": "operation",
        "type": "dropdown",
        "title": "Operation",
        "options": [
          {
            "label": "List Items",
            "value": "list"
          },
          {
            "label": "Get Item",
            "value": "get"
          },
          {
            "label": "Create Item",
            "value": "create"
          },
          {
            "label": "Update Item",
            "value": "update"
          },
          {
            "label": "Delete Item",
            "value": "delete"
          }
        ]
      },
      {
        "id": "credential",
        "type": "oauth-input",
        "title": "Webflow Account",
        "placeholder": "Select Webflow account",
        "serviceId": "webflow"
      },
      {
        "id": "siteSelector",
        "type": "project-selector",
        "title": "Site",
        "placeholder": "Select Webflow site",
        "mode": "basic",
        "canonicalParamId": "siteId"
      },
      {
        "id": "manualSiteId",
        "type": "short-input",
        "title": "Site ID",
        "placeholder": "Enter site ID",
        "mode": "advanced",
        "canonicalParamId": "siteId"
      },
      {
        "id": "collectionSelector",
        "type": "file-selector",
        "title": "Collection",
        "placeholder": "Select collection",
        "mode": "basic",
        "canonicalParamId": "collectionId"
      },
      {
        "id": "manualCollectionId",
        "type": "short-input",
        "title": "Collection ID",
        "placeholder": "Enter collection ID",
        "mode": "advanced",
        "canonicalParamId": "collectionId"
      },
      {
        "id": "itemSelector",
        "type": "file-selector",
        "title": "Item",
        "placeholder": "Select item",
        "mode": "basic",
        "canonicalParamId": "itemId"
      },
      {
        "id": "manualItemId",
        "type": "short-input",
        "title": "Item ID",
        "placeholder": "Enter item ID",
        "mode": "advanced",
        "canonicalParamId": "itemId"
      },
      {
        "id": "offset",
        "type": "short-input",
        "title": "Offset",
        "placeholder": "Pagination offset (optional)"
      },
      {
        "id": "limit",
        "type": "short-input",
        "title": "Limit",
        "placeholder": "Max items to return (optional)"
      },
      {
        "id": "fieldData",
        "type": "code",
        "title": "Field Data",
        "placeholder": "Field data as JSON: "
      },
      {
        "id": "triggerSave",
        "type": "trigger-save",
        "title": "",
        "hideFromPreview": true,
        "mode": "trigger",
        "triggerId": "webflow_collection_item_created"
      },
      {
        "id": "triggerInstructions",
        "type": "text",
        "title": "Setup Instructions",
        "hideFromPreview": true,
        "mode": "trigger",
        "default": "<div class='mb-3'><strong>1.</strong> Connect your Webflow account using OAuth above.</div><div class='mb-3'><strong>2.</strong> Select the site you want to monitor.</div><div class='mb-3'><strong>3.</strong> Optionally select a specific collection to monitor.</div><div class='mb-3'><strong>4.</strong> Select the trigger type (item created, changed, deleted, or form submission).</div><div class='mb-3'><strong>5.</strong> The workflow will receive the relevant data when the selected event occurs.</div>"
      }
    ],
    "tools": {
      "access": [
        "webflow_list_items",
        "webflow_get_item",
        "webflow_create_item",
        "webflow_update_item",
        "webflow_delete_item"
      ],
      "config": {
        "tool": "{{operation}}"
      }
    },
    "inputs": {
      "operation": {
        "type": "string"
      }
    },
    "outputs": {
      "items": {
        "type": "json"
      }
    },
    "triggers": {
      "enabled": true,
      "available": ["webflow_collection_item_created", "webflow_collection_item_changed", "webflow_collection_item_deleted", "webflow_form_submission"]
    },
    "triggerAllowed": true
  },
  "tools": [
    {
      "id": "webflow_create_item",
      "name": "Webflow Create Item",
      "description": "Create a new item in a Webflow CMS collection",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "webflow",
        "operation": "webflow_create_item"
      }
    },
    {
      "id": "webflow_delete_item",
      "name": "Webflow Delete Item",
      "description": "Delete an item from a Webflow CMS collection",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "webflow",
        "operation": "webflow_delete_item"
      }
    },
    {
      "id": "webflow_get_item",
      "name": "Webflow Get Item",
      "description": "Get a single item from a Webflow CMS collection",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "webflow",
        "operation": "webflow_get_item"
      }
    },
    {
      "id": "webflow_list_items",
      "name": "Webflow List Items",
      "description": "List all items from a Webflow CMS collection",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "webflow",
        "operation": "webflow_list_items"
      }
    },
    {
      "id": "webflow_update_item",
      "name": "Webflow Update Item",
      "description": "Update an existing item in a Webflow CMS collection",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "webflow",
        "operation": "webflow_update_item"
      }
    }
  ],
  "triggers": [
    {
      "id": "webflow_collection_item_created",
      "name": "Webflow Item Created",
      "provider": "webflow",
      "description": "Trigger when a collection item is created in Webflow",
      "version": "1.0.0",
      "webhook": { "method": "POST" },
      "credentials": [],
      "outputs": {
        "siteId": { "type": "string", "description": "Webflow site ID" },
        "collectionId": { "type": "string", "description": "Collection ID" },
        "payload": { "type": "object", "description": "Item data with id, cmsLocaleId, lastPublished, lastUpdated, createdOn, isArchived, isDraft, fieldData" }
      }
    },
    {
      "id": "webflow_collection_item_changed",
      "name": "Webflow Item Changed",
      "provider": "webflow",
      "description": "Trigger when a collection item is updated in Webflow",
      "version": "1.0.0",
      "webhook": { "method": "POST" },
      "credentials": [],
      "outputs": {
        "siteId": { "type": "string", "description": "Webflow site ID" },
        "collectionId": { "type": "string", "description": "Collection ID" },
        "payload": { "type": "object", "description": "Item data with id, cmsLocaleId, lastPublished, lastUpdated, createdOn, isArchived, isDraft, fieldData" }
      }
    },
    {
      "id": "webflow_collection_item_deleted",
      "name": "Webflow Item Deleted",
      "provider": "webflow",
      "description": "Trigger when a collection item is deleted in Webflow",
      "version": "1.0.0",
      "webhook": { "method": "POST" },
      "credentials": [],
      "outputs": {
        "siteId": { "type": "string", "description": "Webflow site ID" },
        "collectionId": { "type": "string", "description": "Collection ID" },
        "payload": { "type": "object", "description": "Deleted item data with id, deletedOn" }
      }
    },
    {
      "id": "webflow_form_submission",
      "name": "Webflow Form Submission",
      "provider": "webflow",
      "description": "Trigger when a form is submitted on a Webflow site",
      "version": "1.0.0",
      "webhook": { "method": "POST" },
      "credentials": [],
      "outputs": {
        "siteId": { "type": "string", "description": "Webflow site ID" },
        "formId": { "type": "string", "description": "Form ID" },
        "name": { "type": "string", "description": "Form name" },
        "id": { "type": "string", "description": "Submission ID" },
        "submittedAt": { "type": "string", "description": "Submission timestamp" },
        "data": { "type": "object", "description": "Form submission field data" },
        "schema": { "type": "array", "description": "Form structure" }
      }
    }
  ]
}
