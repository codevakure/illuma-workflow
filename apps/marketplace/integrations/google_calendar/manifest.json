{
  "id": "google_calendar",
  "name": "Google Calendar",
  "version": "1.0.0",
  "description": "Manage Google Calendar events",
  "icon": "GoogleCalendarIcon",
  "block": {
    "type": "google_calendar",
    "name": "Google Calendar",
    "description": "Manage Google Calendar events",
    "longDescription": "Integrate Google Calendar into the workflow. Can create, read, update, and list calendar events.",
    "docsLink": "https://docs.sim.ai/tools/google_calendar",
    "category": "tools",
    "bgColor": "#E0E0E0",
    "icon": "GoogleCalendarIcon",
    "authMode": "oauth",
    "hideFromToolbar": false,
    "subBlocks": [
      {
        "id": "operation",
        "type": "dropdown",
        "title": "Operation",
        "options": [
          {
            "label": "Create Event",
            "value": "create"
          },
          {
            "label": "List Events",
            "value": "list"
          },
          {
            "label": "Get Event",
            "value": "get"
          },
          {
            "label": "Update Event",
            "value": "update"
          },
          {
            "label": "Delete Event",
            "value": "delete"
          },
          {
            "label": "Move Event",
            "value": "move"
          },
          {
            "label": "Get Recurring Instances",
            "value": "instances"
          },
          {
            "label": "List Calendars",
            "value": "list_calendars"
          },
          {
            "label": "Quick Add (Natural Language)",
            "value": "quick_add"
          },
          {
            "label": "Invite Attendees",
            "value": "invite"
          }
        ]
      },
      {
        "id": "credential",
        "type": "oauth-input",
        "title": "Google Calendar Account",
        "placeholder": "Select Google Calendar account",
        "serviceId": "google-calendar"
      },
      {
        "id": "calendarId",
        "type": "file-selector",
        "title": "Calendar",
        "placeholder": "Select calendar",
        "mode": "basic",
        "canonicalParamId": "calendarId"
      },
      {
        "id": "manualCalendarId",
        "type": "short-input",
        "title": "Calendar ID",
        "placeholder": "Enter calendar ID (e.g., primary or calendar@gmail.com)",
        "mode": "advanced",
        "canonicalParamId": "calendarId"
      },
      {
        "id": "summary",
        "type": "short-input",
        "title": "Event Title",
        "placeholder": "Meeting with team"
      },
      {
        "id": "description",
        "type": "long-input",
        "title": "Description",
        "placeholder": "Event description"
      },
      {
        "id": "location",
        "type": "short-input",
        "title": "Location",
        "placeholder": "Conference Room A"
      },
      {
        "id": "startDateTime",
        "type": "short-input",
        "title": "Start Date & Time",
        "placeholder": "2025-06-03T10:00:00-08:00"
      },
      {
        "id": "endDateTime",
        "type": "short-input",
        "title": "End Date & Time",
        "placeholder": "2025-06-03T11:00:00-08:00"
      },
      {
        "id": "attendees",
        "type": "short-input",
        "title": "Attendees (comma-separated emails)",
        "placeholder": "john@example.com, jane@example.com"
      },
      {
        "id": "timeMin",
        "type": "short-input",
        "title": "Start Time Filter",
        "placeholder": "2025-06-03T00:00:00Z"
      },
      {
        "id": "timeMax",
        "type": "short-input",
        "title": "End Time Filter",
        "placeholder": "2025-06-04T00:00:00Z"
      },
      {
        "id": "eventId",
        "type": "short-input",
        "title": "Event ID",
        "placeholder": "Event ID"
      },
      {
        "id": "summary",
        "type": "short-input",
        "title": "New Event Title",
        "placeholder": "Updated meeting title"
      },
      {
        "id": "description",
        "type": "long-input",
        "title": "New Description",
        "placeholder": "Updated event description"
      },
      {
        "id": "location",
        "type": "short-input",
        "title": "New Location",
        "placeholder": "Updated location"
      },
      {
        "id": "startDateTime",
        "type": "short-input",
        "title": "New Start Date & Time",
        "placeholder": "2025-06-03T10:00:00-08:00"
      },
      {
        "id": "endDateTime",
        "type": "short-input",
        "title": "New End Date & Time",
        "placeholder": "2025-06-03T11:00:00-08:00"
      },
      {
        "id": "attendees",
        "type": "short-input",
        "title": "New Attendees (comma-separated emails)",
        "placeholder": "john@example.com, jane@example.com"
      },
      {
        "id": "destinationCalendar",
        "type": "file-selector",
        "title": "Destination Calendar",
        "placeholder": "Select destination calendar",
        "mode": "basic",
        "canonicalParamId": "destinationCalendarId"
      },
      {
        "id": "manualDestinationCalendarId",
        "type": "short-input",
        "title": "Destination Calendar ID",
        "placeholder": "destination@group.calendar.google.com",
        "mode": "advanced",
        "canonicalParamId": "destinationCalendarId"
      },
      {
        "id": "timeMin",
        "type": "short-input",
        "title": "Start Time Filter",
        "placeholder": "2025-06-03T00:00:00Z"
      },
      {
        "id": "timeMax",
        "type": "short-input",
        "title": "End Time Filter",
        "placeholder": "2025-06-04T00:00:00Z"
      },
      {
        "id": "maxResults",
        "type": "short-input",
        "title": "Max Results",
        "placeholder": "250"
      },
      {
        "id": "minAccessRole",
        "type": "dropdown",
        "title": "Minimum Access Role",
        "options": [
          {
            "label": "Free/Busy Reader",
            "value": "freeBusyReader"
          },
          {
            "label": "Reader",
            "value": "reader"
          },
          {
            "label": "Writer",
            "value": "writer"
          },
          {
            "label": "Owner",
            "value": "owner"
          }
        ]
      },
      {
        "id": "attendees",
        "type": "short-input",
        "title": "Attendees (comma-separated emails)",
        "placeholder": "john@example.com, jane@example.com"
      },
      {
        "id": "replaceExisting",
        "type": "dropdown",
        "title": "Replace Existing Attendees",
        "options": [
          {
            "label": "Add to existing attendees",
            "value": "false"
          },
          {
            "label": "Replace all attendees",
            "value": "true"
          }
        ]
      },
      {
        "id": "text",
        "type": "long-input",
        "title": "Natural Language Event",
        "placeholder": "Meeting with John tomorrow at 3pm for 1 hour"
      },
      {
        "id": "attendees",
        "type": "short-input",
        "title": "Attendees (comma-separated emails)",
        "placeholder": "john@example.com, jane@example.com"
      },
      {
        "id": "sendUpdates",
        "type": "dropdown",
        "title": "Send Email Notifications",
        "options": [
          {
            "label": "All attendees",
            "value": "all"
          },
          {
            "label": "External attendees only",
            "value": "externalOnly"
          },
          {
            "label": "None (no emails sent)",
            "value": "none"
          }
        ]
      }
    ],
    "tools": {
      "access": [
        "google_calendar_create",
        "google_calendar_list",
        "google_calendar_get",
        "google_calendar_update",
        "google_calendar_delete",
        "google_calendar_move",
        "google_calendar_instances",
        "google_calendar_list_calendars",
        "google_calendar_quick_add",
        "google_calendar_invite"
      ],
      "config": {
        "tool": "{{operation}}"
      }
    },
    "inputs": {
      "operation": {
        "type": "string"
      }
    },
    "outputs": {
      "content": {
        "type": "string"
      }
    }
  },
  "tools": [
    {
      "id": "google_calendar_create",
      "name": "Google Calendar Create Event",
      "description": "Create a new event in Google Calendar",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "google_calendar",
        "operation": "google_calendar_create"
      }
    },
    {
      "id": "google_calendar_delete",
      "name": "Google Calendar Delete Event",
      "description": "Delete an event from Google Calendar",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "google_calendar",
        "operation": "google_calendar_delete"
      }
    },
    {
      "id": "google_calendar_get",
      "name": "Google Calendar Get Event",
      "description": "Get a specific event from Google Calendar",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "google_calendar",
        "operation": "google_calendar_get"
      }
    },
    {
      "id": "google_calendar_instances",
      "name": "Google Calendar Get Instances",
      "description": "Get instances of a recurring event from Google Calendar",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "google_calendar",
        "operation": "google_calendar_instances"
      }
    },
    {
      "id": "google_calendar_invite",
      "name": "Google Calendar Invite Attendees",
      "description": "Invite attendees to an existing Google Calendar event",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "google_calendar",
        "operation": "google_calendar_invite"
      }
    },
    {
      "id": "google_calendar_list",
      "name": "Google Calendar List Events",
      "description": "List events from Google Calendar",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "google_calendar",
        "operation": "google_calendar_list"
      }
    },
    {
      "id": "google_calendar_list_calendars",
      "name": "Google Calendar List Calendars",
      "description": "List all calendars in the user",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "google_calendar",
        "operation": "google_calendar_list_calendars"
      }
    },
    {
      "id": "google_calendar_move",
      "name": "Google Calendar Move Event",
      "description": "Move an event to a different calendar",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "google_calendar",
        "operation": "google_calendar_move"
      }
    },
    {
      "id": "google_calendar_quick_add",
      "name": "Google Calendar Quick Add",
      "description": "Create events from natural language text",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "google_calendar",
        "operation": "google_calendar_quick_add"
      }
    },
    {
      "id": "google_calendar_update",
      "name": "Google Calendar Update Event",
      "description": "Update an existing event in Google Calendar",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "google_calendar",
        "operation": "google_calendar_update"
      }
    }
  ]
}
