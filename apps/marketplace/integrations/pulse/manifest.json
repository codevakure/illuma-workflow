{
  "id": "pulse",
  "name": "Pulse",
  "version": "1.0.0",
  "description": "Extract text from documents using Pulse OCR",
  "icon": "PulseIcon",
  "block": {
    "type": "pulse",
    "name": "Pulse",
    "description": "Extract text from documents using Pulse OCR",
    "longDescription": "Integrate Pulse into the workflow. Extract text from PDF documents, images, and Office files via URL or upload.",
    "docsLink": "https://docs.sim.ai/tools/pulse",
    "category": "tools",
    "bgColor": "#E0E0E0",
    "icon": "PulseIcon",
    "authMode": "api_key",
    "hideFromToolbar": false,
    "subBlocks": [
      {
        "id": "fileUpload",
        "type": "file-upload",
        "title": "Document",
        "placeholder": "Upload a document",
        "mode": "basic",
        "canonicalParamId": "document"
      },
      {
        "id": "filePath",
        "type": "short-input",
        "title": "Document",
        "placeholder": "Document URL",
        "mode": "advanced",
        "canonicalParamId": "document"
      },
      {
        "id": "pages",
        "type": "short-input",
        "title": "Specific Pages",
        "placeholder": "e.g. 1-3,5 (leave empty for all pages)"
      },
      {
        "id": "chunking",
        "type": "short-input",
        "title": "Chunking Strategy",
        "placeholder": "e.g. semantic,header,page,recursive"
      },
      {
        "id": "chunkSize",
        "type": "short-input",
        "title": "Chunk Size",
        "placeholder": "Max characters per chunk"
      },
      {
        "id": "apiKey",
        "type": "short-input",
        "title": "API Key",
        "placeholder": "Enter your Pulse API key",
        "password": true
      }
    ],
    "tools": {
      "access": [
        "pulse_parser"
      ],
      "config": {
        "tool": "pulse_parser"
      }
    },
    "inputs": {
      "document": {
        "type": "json"
      }
    },
    "outputs": {
      "markdown": {
        "type": "string"
      }
    }
  },
  "tools": [
    {
      "id": "pulse_parser",
      "name": "Pulse Document Parser",
      "description": "Parse documents (PDF, images, Office docs) using Pulse OCR API",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "pulse",
        "operation": "pulse_parser"
      }
    }
  ]
}
