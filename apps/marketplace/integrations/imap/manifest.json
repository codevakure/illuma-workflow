{
  "id": "imap",
  "name": "IMAP Email",
  "version": "1.0.0",
  "description": "Trigger workflows when new emails arrive via IMAP (works with any email provider)",
  "icon": "MailServerIcon",
  "block": {
    "type": "imap",
    "name": "IMAP Email",
    "description": "Trigger workflows when new emails arrive via IMAP (works with any email provider)",
    "longDescription": "Connect to any email server via IMAP protocol to trigger workflows when new emails are received. Supports Gmail, Outlook, Yahoo, and any other IMAP-compatible email provider.",
    "docsLink": "https://docs.sim.ai/tools/imap",
    "category": "triggers",
    "bgColor": "#6366F1",
    "icon": "MailServerIcon",
    "hideFromToolbar": false,
    "triggerAllowed": true,
    "subBlocks": [
      {
        "id": "host",
        "type": "short-input",
        "title": "IMAP Server",
        "placeholder": "imap.example.com",
        "description": "IMAP server hostname (e.g., imap.gmail.com, outlook.office365.com)",
        "required": true,
        "mode": "trigger"
      },
      {
        "id": "port",
        "type": "short-input",
        "title": "Port",
        "placeholder": "993",
        "description": "IMAP port (993 for SSL/TLS, 143 for STARTTLS)",
        "default": "993",
        "required": true,
        "mode": "trigger"
      },
      {
        "id": "secure",
        "type": "switch",
        "title": "Use SSL/TLS",
        "default": true,
        "description": "Enable SSL/TLS encryption (recommended for port 993)",
        "required": false,
        "mode": "trigger"
      },
      {
        "id": "rejectUnauthorized",
        "type": "switch",
        "title": "Verify TLS Certificate",
        "default": true,
        "description": "Verify server TLS certificate. Disable for self-signed certificates.",
        "required": false,
        "mode": "trigger"
      },
      {
        "id": "username",
        "type": "short-input",
        "title": "Username",
        "placeholder": "user@example.com",
        "description": "Email address or username for authentication",
        "required": true,
        "mode": "trigger"
      },
      {
        "id": "password",
        "type": "short-input",
        "title": "Password",
        "password": true,
        "placeholder": "App password or email password",
        "description": "Password or app-specific password (for Gmail, use an App Password)",
        "required": true,
        "mode": "trigger"
      },
      {
        "id": "mailbox",
        "type": "short-input",
        "title": "Mailbox",
        "placeholder": "INBOX",
        "description": "Mailbox/folder to monitor for new emails. Default: INBOX.",
        "required": false,
        "default": "INBOX",
        "mode": "trigger"
      },
      {
        "id": "searchCriteria",
        "type": "code",
        "title": "Search Criteria",
        "placeholder": "{ \"unseen\": true }",
        "description": "ImapFlow search criteria as JSON object. Default: unseen messages only.",
        "default": "{ \"unseen\": true }",
        "required": false,
        "mode": "trigger"
      },
      {
        "id": "markAsRead",
        "type": "switch",
        "title": "Mark as Read",
        "default": true,
        "description": "Automatically mark emails as read (SEEN) after processing",
        "required": false,
        "mode": "trigger"
      },
      {
        "id": "includeAttachments",
        "type": "switch",
        "title": "Include Attachments",
        "default": false,
        "description": "Download and include email attachments in the trigger payload",
        "required": false,
        "mode": "trigger"
      },
      {
        "id": "triggerSave",
        "type": "trigger-save",
        "title": "",
        "hideFromPreview": true,
        "mode": "trigger",
        "triggerId": "imap_poller"
      },
      {
        "id": "triggerInstructions",
        "type": "text",
        "title": "Setup Instructions",
        "hideFromPreview": true,
        "mode": "trigger",
        "default": "<div class='mb-3'><strong>1.</strong> Enter your IMAP server details (host, port, SSL settings)</div><div class='mb-3'><strong>2.</strong> Enter your email credentials (username and password)</div><div class='mb-3'><strong>3.</strong> For Gmail: Use an <a href='https://support.google.com/accounts/answer/185833' target='_blank'>App Password</a> instead of your regular password</div><div class='mb-3'><strong>4.</strong> Select the mailbox to monitor (INBOX is most common)</div><div class='mb-3'><strong>5.</strong> Optionally configure search criteria and processing options</div><div class='mb-3'><strong>6.</strong> The system will automatically check for new emails and trigger your workflow</div>"
      }
    ],
    "tools": {
      "access": [],
      "config": {
        "tool": ""
      }
    },
    "inputs": {
      "host": {
        "type": "string",
        "description": "IMAP server hostname"
      },
      "port": {
        "type": "string",
        "description": "IMAP server port"
      },
      "secure": {
        "type": "boolean",
        "description": "Use SSL/TLS encryption"
      },
      "rejectUnauthorized": {
        "type": "boolean",
        "description": "Verify TLS certificate"
      },
      "username": {
        "type": "string",
        "description": "Email username"
      },
      "password": {
        "type": "string",
        "description": "Email password"
      },
      "mailbox": {
        "type": "string",
        "description": "Mailbox to monitor"
      },
      "searchCriteria": {
        "type": "string",
        "description": "IMAP search criteria"
      },
      "markAsRead": {
        "type": "boolean",
        "description": "Mark emails as read after processing"
      },
      "includeAttachments": {
        "type": "boolean",
        "description": "Include email attachments"
      }
    },
    "outputs": {
      "messageId": {
        "type": "string",
        "description": "RFC Message-ID header"
      },
      "subject": {
        "type": "string",
        "description": "Email subject line"
      },
      "from": {
        "type": "string",
        "description": "Sender email address"
      },
      "to": {
        "type": "string",
        "description": "Recipient email address"
      },
      "cc": {
        "type": "string",
        "description": "CC recipients"
      },
      "date": {
        "type": "string",
        "description": "Email date in ISO format"
      },
      "bodyText": {
        "type": "string",
        "description": "Plain text email body"
      },
      "bodyHtml": {
        "type": "string",
        "description": "HTML email body"
      },
      "mailbox": {
        "type": "string",
        "description": "Mailbox/folder where email was received"
      },
      "hasAttachments": {
        "type": "boolean",
        "description": "Whether email has attachments"
      },
      "attachments": {
        "type": "file[]",
        "description": "Array of email attachments"
      },
      "timestamp": {
        "type": "string",
        "description": "Event timestamp"
      }
    },
    "triggers": {
      "enabled": true,
      "available": [
        "imap_poller"
      ]
    }
  },
  "tools": [
    {
      "id": "imap_execute",
      "name": "imap execute",
      "description": "",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "imap",
        "operation": "execute"
      }
    }
  ],
  "triggers": [
    {
      "id": "imap_poller",
      "name": "IMAP Email",
      "provider": "imap",
      "description": "Trigger workflow when new emails arrive via IMAP",
      "version": "1.0.0",
      "credentials": [
        { "id": "host", "label": "IMAP Host", "type": "string", "required": true, "description": "IMAP server hostname", "placeholder": "imap.gmail.com" },
        { "id": "port", "label": "Port", "type": "string", "required": true, "description": "IMAP port (usually 993)", "placeholder": "993" },
        { "id": "username", "label": "Username", "type": "string", "required": true, "description": "Email/username for IMAP login", "placeholder": "user@example.com" },
        { "id": "password", "label": "Password", "type": "password", "required": true, "description": "Password or app password", "placeholder": "Enter password" }
      ],
      "outputs": {
        "email": {
          "type": "object",
          "description": "Email message",
          "properties": {
            "messageId": { "type": "string", "description": "Email message ID" },
            "subject": { "type": "string", "description": "Email subject" },
            "from": { "type": "string", "description": "Sender address" },
            "to": { "type": "string", "description": "Recipient address" },
            "cc": { "type": "string", "description": "CC recipients" },
            "date": { "type": "string", "description": "Email date" },
            "bodyText": { "type": "string", "description": "Plain text body" },
            "bodyHtml": { "type": "string", "description": "HTML body" },
            "hasAttachments": { "type": "boolean", "description": "Whether email has attachments" },
            "attachments": { "type": "file[]", "description": "Email attachments" }
          }
        },
        "timestamp": { "type": "string", "description": "Event timestamp" }
      }
    }
  ]
}