{
  "id": "shopify",
  "name": "Shopify",
  "version": "1.0.0",
  "description": "Manage products, orders, customers, and inventory in your Shopify store",
  "icon": "ShopifyIcon",
  "block": {
    "type": "shopify",
    "name": "Shopify",
    "description": "Manage products, orders, customers, and inventory in your Shopify store",
    "longDescription": "Integrate Shopify into your workflow. Manage products, orders, customers, and inventory. Create, read, update, and delete products. List and manage orders. Handle customer data and adjust inventory levels.",
    "docsLink": "https://docs.sim.ai/tools/shopify",
    "category": "tools",
    "bgColor": "#FFFFFF",
    "icon": "ShopifyIcon",
    "authMode": "oauth",
    "subBlocks": [
      {
        "id": "operation",
        "type": "dropdown",
        "title": "Operation",
        "options": [
          {
            "label": "Create Product",
            "value": "shopify_create_product"
          },
          {
            "label": "Get Product",
            "value": "shopify_get_product"
          },
          {
            "label": "List Products",
            "value": "shopify_list_products"
          },
          {
            "label": "Update Product",
            "value": "shopify_update_product"
          },
          {
            "label": "Delete Product",
            "value": "shopify_delete_product"
          },
          {
            "label": "Get Order",
            "value": "shopify_get_order"
          },
          {
            "label": "List Orders",
            "value": "shopify_list_orders"
          },
          {
            "label": "Update Order",
            "value": "shopify_update_order"
          },
          {
            "label": "Cancel Order",
            "value": "shopify_cancel_order"
          },
          {
            "label": "Create Customer",
            "value": "shopify_create_customer"
          },
          {
            "label": "Get Customer",
            "value": "shopify_get_customer"
          },
          {
            "label": "List Customers",
            "value": "shopify_list_customers"
          },
          {
            "label": "Update Customer",
            "value": "shopify_update_customer"
          },
          {
            "label": "Delete Customer",
            "value": "shopify_delete_customer"
          },
          {
            "label": "List Inventory Items",
            "value": "shopify_list_inventory_items"
          },
          {
            "label": "Get Inventory Level",
            "value": "shopify_get_inventory_level"
          },
          {
            "label": "Adjust Inventory",
            "value": "shopify_adjust_inventory"
          },
          {
            "label": "List Locations",
            "value": "shopify_list_locations"
          },
          {
            "label": "Create Fulfillment",
            "value": "shopify_create_fulfillment"
          },
          {
            "label": "List Collections",
            "value": "shopify_list_collections"
          },
          {
            "label": "Get Collection",
            "value": "shopify_get_collection"
          }
        ]
      },
      {
        "id": "credential",
        "type": "oauth-input",
        "title": "Shopify Account",
        "placeholder": "Select Shopify account"
      },
      {
        "id": "shopDomain",
        "type": "short-input",
        "title": "Shop Domain",
        "placeholder": "Auto-detected from OAuth or enter manually"
      },
      {
        "id": "productId",
        "type": "short-input",
        "title": "Product ID",
        "placeholder": "gid://shopify/Product/123456789"
      },
      {
        "id": "title",
        "type": "short-input",
        "title": "Product Title",
        "placeholder": "Enter product title"
      },
      {
        "id": "descriptionHtml",
        "type": "long-input",
        "title": "Description (HTML)",
        "placeholder": "Enter product description"
      },
      {
        "id": "productType",
        "type": "short-input",
        "title": "Product Type",
        "placeholder": "e.g., Shoes, Electronics"
      },
      {
        "id": "vendor",
        "type": "short-input",
        "title": "Vendor",
        "placeholder": "Enter vendor name"
      },
      {
        "id": "tags",
        "type": "short-input",
        "title": "Tags",
        "placeholder": "tag1, tag2, tag3 (comma-separated)"
      },
      {
        "id": "status",
        "type": "dropdown",
        "title": "Status",
        "options": [
          {
            "label": "Active",
            "value": "ACTIVE"
          },
          {
            "label": "Draft",
            "value": "DRAFT"
          },
          {
            "label": "Archived",
            "value": "ARCHIVED"
          }
        ]
      },
      {
        "id": "productQuery",
        "type": "short-input",
        "title": "Search Query",
        "placeholder": "Filter products (optional)"
      },
      {
        "id": "customerQuery",
        "type": "short-input",
        "title": "Search Query",
        "placeholder": "e.g., first_name:John OR email:*@gmail.com"
      },
      {
        "id": "inventoryQuery",
        "type": "short-input",
        "title": "Search Query",
        "placeholder": "e.g., sku:ABC123"
      },
      {
        "id": "orderId",
        "type": "short-input",
        "title": "Order ID",
        "placeholder": "gid://shopify/Order/123456789"
      },
      {
        "id": "orderStatus",
        "type": "dropdown",
        "title": "Order Status",
        "options": [
          {
            "label": "Any",
            "value": "any"
          },
          {
            "label": "Open",
            "value": "open"
          },
          {
            "label": "Closed",
            "value": "closed"
          },
          {
            "label": "Cancelled",
            "value": "cancelled"
          }
        ]
      },
      {
        "id": "orderNote",
        "type": "long-input",
        "title": "Order Note",
        "placeholder": "Enter order note"
      },
      {
        "id": "orderEmail",
        "type": "short-input",
        "title": "Customer Email",
        "placeholder": "customer@example.com"
      },
      {
        "id": "orderTags",
        "type": "short-input",
        "title": "Order Tags",
        "placeholder": "tag1, tag2, tag3 (comma-separated)"
      },
      {
        "id": "cancelReason",
        "type": "dropdown",
        "title": "Cancel Reason",
        "options": [
          {
            "label": "Customer Request",
            "value": "CUSTOMER"
          },
          {
            "label": "Declined Payment",
            "value": "DECLINED"
          },
          {
            "label": "Fraud",
            "value": "FRAUD"
          },
          {
            "label": "Inventory Issue",
            "value": "INVENTORY"
          },
          {
            "label": "Other",
            "value": "OTHER"
          }
        ]
      },
      {
        "id": "staffNote",
        "type": "long-input",
        "title": "Staff Note",
        "placeholder": "Internal note about this cancellation"
      },
      {
        "id": "customerId",
        "type": "short-input",
        "title": "Customer ID",
        "placeholder": "gid://shopify/Customer/123456789"
      },
      {
        "id": "customerEmail",
        "type": "short-input",
        "title": "Email",
        "placeholder": "customer@example.com"
      },
      {
        "id": "firstName",
        "type": "short-input",
        "title": "First Name",
        "placeholder": "Enter first name"
      },
      {
        "id": "lastName",
        "type": "short-input",
        "title": "Last Name",
        "placeholder": "Enter last name"
      },
      {
        "id": "phone",
        "type": "short-input",
        "title": "Phone",
        "placeholder": "+1234567890"
      },
      {
        "id": "customerNote",
        "type": "long-input",
        "title": "Customer Note",
        "placeholder": "Enter note about customer"
      },
      {
        "id": "customerTags",
        "type": "short-input",
        "title": "Customer Tags",
        "placeholder": "vip, wholesale (comma-separated)"
      },
      {
        "id": "acceptsMarketing",
        "type": "switch",
        "title": "Accepts Marketing"
      },
      {
        "id": "inventoryItemId",
        "type": "short-input",
        "title": "Inventory Item ID",
        "placeholder": "gid://shopify/InventoryItem/123456789"
      },
      {
        "id": "locationId",
        "type": "short-input",
        "title": "Location ID",
        "placeholder": "gid://shopify/Location/123456789"
      },
      {
        "id": "delta",
        "type": "short-input",
        "title": "Quantity Change",
        "placeholder": "Positive to add, negative to subtract"
      },
      {
        "id": "fulfillmentOrderId",
        "type": "short-input",
        "title": "Fulfillment Order ID",
        "placeholder": "gid://shopify/FulfillmentOrder/123456789"
      },
      {
        "id": "trackingNumber",
        "type": "short-input",
        "title": "Tracking Number",
        "placeholder": "Enter tracking number"
      },
      {
        "id": "trackingCompany",
        "type": "short-input",
        "title": "Shipping Carrier",
        "placeholder": "e.g., UPS, FedEx, USPS, DHL"
      },
      {
        "id": "trackingUrl",
        "type": "short-input",
        "title": "Tracking URL",
        "placeholder": "https://..."
      },
      {
        "id": "notifyCustomer",
        "type": "switch",
        "title": "Notify Customer"
      },
      {
        "id": "collectionId",
        "type": "short-input",
        "title": "Collection ID",
        "placeholder": "gid://shopify/Collection/123456789"
      },
      {
        "id": "collectionQuery",
        "type": "short-input",
        "title": "Search Query",
        "placeholder": "e.g., title:Summer OR collection_type:smart"
      }
    ],
    "tools": {
      "access": [
        "shopify_create_product",
        "shopify_get_product",
        "shopify_list_products",
        "shopify_update_product",
        "shopify_delete_product",
        "shopify_get_order",
        "shopify_list_orders",
        "shopify_update_order",
        "shopify_cancel_order",
        "shopify_create_customer",
        "shopify_get_customer",
        "shopify_list_customers",
        "shopify_update_customer",
        "shopify_delete_customer",
        "shopify_list_inventory_items",
        "shopify_get_inventory_level",
        "shopify_adjust_inventory",
        "shopify_list_locations",
        "shopify_create_fulfillment",
        "shopify_list_collections",
        "shopify_get_collection"
      ],
      "config": {
        "tool": "{{operation}}"
      }
    },
    "inputs": {
      "operation": {
        "type": "string"
      }
    },
    "outputs": {
      "product": {
        "type": "json"
      }
    }
  },
  "tools": [
    {
      "id": "shopify_adjust_inventory",
      "name": "Shopify Adjust Inventory",
      "description": "Adjust inventory quantity for a product variant at a specific location",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_adjust_inventory"
      }
    },
    {
      "id": "shopify_cancel_order",
      "name": "Shopify Cancel Order",
      "description": "Cancel an order in your Shopify store",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_cancel_order"
      }
    },
    {
      "id": "shopify_create_customer",
      "name": "Shopify Create Customer",
      "description": "Create a new customer in your Shopify store",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_create_customer"
      }
    },
    {
      "id": "shopify_create_fulfillment",
      "name": "Shopify Create Fulfillment",
      "description": "Create a fulfillment to mark order items as shipped. Requires a fulfillment order ID (get this from the order details).",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_create_fulfillment"
      }
    },
    {
      "id": "shopify_create_product",
      "name": "Shopify Create Product",
      "description": "Create a new product in your Shopify store",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_create_product"
      }
    },
    {
      "id": "shopify_delete_customer",
      "name": "Shopify Delete Customer",
      "description": "Delete a customer from your Shopify store",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_delete_customer"
      }
    },
    {
      "id": "shopify_delete_product",
      "name": "Shopify Delete Product",
      "description": "Delete a product from your Shopify store",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_delete_product"
      }
    },
    {
      "id": "shopify_get_collection",
      "name": "Shopify Get Collection",
      "description": "Get a specific collection by ID, including its products. Use this to retrieve products within a collection.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_get_collection"
      }
    },
    {
      "id": "shopify_get_customer",
      "name": "Shopify Get Customer",
      "description": "Get a single customer by ID from your Shopify store",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_get_customer"
      }
    },
    {
      "id": "shopify_get_inventory_level",
      "name": "Shopify Get Inventory Level",
      "description": "Get inventory level for a product variant at a specific location",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_get_inventory_level"
      }
    },
    {
      "id": "shopify_get_order",
      "name": "Shopify Get Order",
      "description": "Get a single order by ID from your Shopify store",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_get_order"
      }
    },
    {
      "id": "shopify_get_product",
      "name": "Shopify Get Product",
      "description": "Get a single product by ID from your Shopify store",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_get_product"
      }
    },
    {
      "id": "shopify_list_collections",
      "name": "Shopify List Collections",
      "description": "List product collections from your Shopify store. Filter by title, type (custom/smart), or handle.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_list_collections"
      }
    },
    {
      "id": "shopify_list_customers",
      "name": "Shopify List Customers",
      "description": "List customers from your Shopify store with optional filtering",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_list_customers"
      }
    },
    {
      "id": "shopify_list_inventory_items",
      "name": "Shopify List Inventory Items",
      "description": "List inventory items from your Shopify store. Use this to find inventory item IDs by SKU.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_list_inventory_items"
      }
    },
    {
      "id": "shopify_list_locations",
      "name": "Shopify List Locations",
      "description": "List inventory locations from your Shopify store. Use this to find location IDs needed for inventory operations.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_list_locations"
      }
    },
    {
      "id": "shopify_list_orders",
      "name": "Shopify List Orders",
      "description": "List orders from your Shopify store with optional filtering",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_list_orders"
      }
    },
    {
      "id": "shopify_list_products",
      "name": "Shopify List Products",
      "description": "List products from your Shopify store with optional filtering",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_list_products"
      }
    },
    {
      "id": "shopify_update_customer",
      "name": "Shopify Update Customer",
      "description": "Update an existing customer in your Shopify store",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_update_customer"
      }
    },
    {
      "id": "shopify_update_order",
      "name": "Shopify Update Order",
      "description": "Update an existing order in your Shopify store (note, tags, email)",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_update_order"
      }
    },
    {
      "id": "shopify_update_product",
      "name": "Shopify Update Product",
      "description": "Update an existing product in your Shopify store",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "shopify",
        "operation": "shopify_update_product"
      }
    }
  ]
}
