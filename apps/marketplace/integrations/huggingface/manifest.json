{
  "id": "huggingface",
  "name": "Hugging Face",
  "version": "1.0.0",
  "description": "Use Hugging Face Inference API",
  "icon": "HuggingFaceIcon",
  "block": {
    "type": "huggingface",
    "name": "Hugging Face",
    "description": "Use Hugging Face Inference API",
    "longDescription": "Integrate Hugging Face into the workflow. Can generate completions using the Hugging Face Inference API.",
    "docsLink": "https://docs.sim.ai/tools/huggingface",
    "category": "tools",
    "bgColor": "#0B0F19",
    "icon": "HuggingFaceIcon",
    "authMode": "api_key",
    "subBlocks": [
      {
        "id": "systemPrompt",
        "type": "long-input",
        "title": "System Prompt",
        "placeholder": "Enter system prompt to guide the model behavior..."
      },
      {
        "id": "content",
        "type": "long-input",
        "title": "User Prompt",
        "placeholder": "Enter your message here..."
      },
      {
        "id": "provider",
        "type": "dropdown",
        "title": "Provider",
        "options": [
          {
            "label": "Novita",
            "value": "novita"
          },
          {
            "label": "Cerebras",
            "value": "cerebras"
          },
          {
            "label": "Cohere",
            "value": "cohere"
          },
          {
            "label": "Fal AI",
            "value": "fal"
          },
          {
            "label": "Fireworks",
            "value": "fireworks"
          },
          {
            "label": "Hyperbolic",
            "value": "hyperbolic"
          },
          {
            "label": "HF Inference",
            "value": "hf-inference"
          },
          {
            "label": "Nebius",
            "value": "nebius"
          },
          {
            "label": "Nscale",
            "value": "nscale"
          },
          {
            "label": "Replicate",
            "value": "replicate"
          },
          {
            "label": "SambaNova",
            "value": "sambanova"
          },
          {
            "label": "Together",
            "value": "together"
          }
        ]
      },
      {
        "id": "model",
        "type": "short-input",
        "title": "Model",
        "placeholder": "e.g., deepseek/deepseek-v3-0324, llama3.1-8b, meta-llama/Llama-3.2-3B-Instruct-Turbo"
      },
      {
        "id": "temperature",
        "type": "slider",
        "title": "Temperature",
        "min": 0,
        "max": 2
      },
      {
        "id": "maxTokens",
        "type": "short-input",
        "title": "Max Tokens",
        "placeholder": "e.g., 1000"
      },
      {
        "id": "apiKey",
        "type": "short-input",
        "title": "API Token",
        "placeholder": "Enter your Hugging Face API token",
        "password": true
      }
    ],
    "tools": {
      "access": [
        "huggingface_chat"
      ],
      "config": {
        "tool": "huggingface_chat"
      }
    },
    "inputs": {
      "systemPrompt": {
        "type": "string"
      }
    },
    "outputs": {
      "content": {
        "type": "string"
      }
    }
  },
  "tools": [
    {
      "id": "huggingface_chat",
      "name": "Hugging Face Chat",
      "description": "Generate completions using Hugging Face Inference API",
      "version": "1.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "huggingface",
        "operation": "huggingface_chat"
      }
    }
  ]
}
