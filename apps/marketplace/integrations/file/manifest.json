{
  "id": "file",
  "name": "File",
  "version": "1.0.0",
  "description": "Read and parse multiple files",
  "icon": "DocumentIcon",
  "block": {
    "type": "file",
    "name": "File",
    "description": "Read and parse multiple files",
    "longDescription": "Upload files directly or import from external URLs to get parsed file objects for use in other blocks.",
    "docsLink": "https://docs.sim.ai/tools/file",
    "category": "tools",
    "bgColor": "#40916C",
    "icon": "DocumentIcon",
    "hideFromToolbar": false,
    "subBlocks": [
      {
        "id": "file",
        "type": "file-upload",
        "title": "Files",
        "placeholder": "Upload files to process",
        "mode": "basic",
        "canonicalParamId": "fileInput"
      },
      {
        "id": "fileUrl",
        "type": "short-input",
        "title": "File URL",
        "placeholder": "https://example.com/document.pdf",
        "mode": "advanced",
        "canonicalParamId": "fileInput"
      }
    ],
    "tools": {
      "access": [
        "file_parser"
      ],
      "config": {
        "tool": "file_parser"
      }
    },
    "inputs": {
      "fileInput": { "type": "json", "description": "File input (canonical param)" },
      "fileType": { "type": "string", "description": "File type" }
    },
    "outputs": {
      "files": {
        "type": "file[]",
        "description": "Parsed files with content, metadata, and file properties"
      },
      "combinedContent": {
        "type": "string",
        "description": "All file contents merged into a single text string"
      }
    }
  },
  "tools": [
    {
      "id": "file_parser",
      "name": "File Parser",
      "description": "Parse one or more uploaded files or files from URLs (text, PDF, CSV, images, etc.)",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "file",
        "operation": "file_parser"
      }
    }
  ]
}
