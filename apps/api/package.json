    "@aws-sdk/client-sqs": "^3.985.0",
    "@aws-sdk/lib-dynamodb": "^3.985.0",
    "@aws-sdk/s3-request-presigner": "^3.779.0",
    "@azure/storage-blob": "^12.30.0",
    "@cerebras/cerebras_cloud_sdk": "^1.64.1",
