{
  "id": "hunter",
  "name": "Hunter",
  "version": "1.0.0",
  "description": "Find and verify email addresses with Hunter.io",
  "icon": "HunterIcon",

  "block": {
    "type": "hunter",
    "name": "Hunter",
    "description": "Find Emails with Hunter",
    "longDescription": "Find professional email addresses, verify emails, discover companies, and search domains using Hunter.io's comprehensive email intelligence platform.",
    "docsLink": "https://docs.sim.ai/tools/hunter",
    "category": "tools",
    "bgColor": "#FF6633",
    "icon": "HunterIcon",
    "authMode": "api_key",
    "operations": [
      { "value": "domain_search", "label": "Domain Search", "toolId": "hunter_domain_search" },
      { "value": "email_finder", "label": "Email Finder", "toolId": "hunter_email_finder" },
      { "value": "email_verifier", "label": "Email Verifier", "toolId": "hunter_email_verifier" },
      { "value": "discover", "label": "Discover Companies", "toolId": "hunter_discover" },
      { "value": "companies_find", "label": "Find Company", "toolId": "hunter_companies_find" },
      { "value": "email_count", "label": "Email Count", "toolId": "hunter_email_count" }
    ],
    "subBlocks": [
      {
        "id": "operation",
        "title": "Operation",
        "type": "dropdown",
        "options": [
          { "value": "domain_search", "label": "Domain Search" },
          { "value": "email_finder", "label": "Email Finder" },
          { "value": "email_verifier", "label": "Email Verifier" },
          { "value": "discover", "label": "Discover Companies" },
          { "value": "companies_find", "label": "Find Company" },
          { "value": "email_count", "label": "Email Count" }
        ],
        "default": "domain_search"
      },
      {
        "id": "domain",
        "title": "Domain",
        "type": "short-input",
        "placeholder": "example.com",
        "required": true,
        "condition": { "field": "operation", "value": ["domain_search", "email_count"] }
      },
      {
        "id": "email",
        "title": "Email Address",
        "type": "short-input",
        "placeholder": "john@example.com",
        "required": true,
        "condition": { "field": "operation", "value": "email_verifier" }
      },
      {
        "id": "first_name",
        "title": "First Name",
        "type": "short-input",
        "placeholder": "John",
        "condition": { "field": "operation", "value": "email_finder" }
      },
      {
        "id": "last_name",
        "title": "Last Name",
        "type": "short-input",
        "placeholder": "Doe",
        "condition": { "field": "operation", "value": "email_finder" }
      },
      {
        "id": "company",
        "title": "Company Domain",
        "type": "short-input",
        "placeholder": "example.com",
        "required": true,
        "condition": { "field": "operation", "value": "email_finder" }
      },
      {
        "id": "query",
        "title": "Search Query",
        "type": "short-input",
        "placeholder": "Technology companies",
        "condition": { "field": "operation", "value": ["discover", "companies_find"] }
      },
      {
        "id": "apiKey",
        "title": "API Key",
        "type": "short-input",
        "placeholder": "Enter your Hunter API key...",
        "required": true,
        "password": true
      }
    ],
    "tools": {
      "access": ["hunter_domain_search", "hunter_email_finder", "hunter_email_verifier", "hunter_discover", "hunter_companies_find", "hunter_email_count"],
      "config": {
        "tool": "hunter_{{operation}}"
      }
    },
    "inputs": {
      "domain": { "type": "string", "description": "Domain name to search" },
      "email": { "type": "string", "description": "Email address to verify" },
      "query": { "type": "string", "description": "Search query for company discovery" }
    },
    "outputs": {
      "emails": { "type": "json", "description": "Found email addresses" },
      "verification": { "type": "json", "description": "Email verification result" },
      "companies": { "type": "json", "description": "Discovered companies" },
      "count": { "type": "number", "description": "Total email count for domain" }
    }
  },

  "tools": [
    {
      "id": "hunter_domain_search",
      "name": "Hunter Domain Search",
      "description": "Search for email addresses associated with a domain.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "proxy": {
        "handler": "hunter",
        "operation": "domain-search"
      },
      "params": {
        "domain": { "type": "string", "required": true, "visibility": "user-or-llm", "description": "Domain to search" },
        "limit": { "type": "number", "required": false, "visibility": "user-only", "description": "Max results" },
        "apiKey": { "type": "string", "required": true, "visibility": "user-only", "description": "Hunter API Key" }
      },
      "outputs": {
        "domain": { "type": "string", "description": "Searched domain" },
        "emails": { "type": "array", "description": "Found email addresses" }
      }
    },
    {
      "id": "hunter_email_finder",
      "name": "Hunter Email Finder",
      "description": "Find an email address given a name and company domain.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "proxy": {
        "handler": "hunter",
        "operation": "email-finder"
      },
      "params": {
        "company": { "type": "string", "required": true, "visibility": "user-or-llm", "description": "Company domain" },
        "first_name": { "type": "string", "required": false, "visibility": "user-or-llm", "description": "First name" },
        "last_name": { "type": "string", "required": false, "visibility": "user-or-llm", "description": "Last name" },
        "apiKey": { "type": "string", "required": true, "visibility": "user-only", "description": "Hunter API Key" }
      },
      "outputs": {
        "email": { "type": "string", "description": "Found email address" },
        "score": { "type": "number", "description": "Confidence score" }
      }
    },
    {
      "id": "hunter_email_verifier",
      "name": "Hunter Email Verifier",
      "description": "Verify if an email address is valid and deliverable.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "proxy": {
        "handler": "hunter",
        "operation": "email-verifier"
      },
      "params": {
        "email": { "type": "string", "required": true, "visibility": "user-or-llm", "description": "Email to verify" },
        "apiKey": { "type": "string", "required": true, "visibility": "user-only", "description": "Hunter API Key" }
      },
      "outputs": {
        "email": { "type": "string", "description": "Verified email" },
        "result": { "type": "string", "description": "Verification result" },
        "score": { "type": "number", "description": "Confidence score" }
      }
    },
    {
      "id": "hunter_discover",
      "name": "Hunter Discover",
      "description": "Discover companies matching search criteria.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "proxy": {
        "handler": "hunter",
        "operation": "discover"
      },
      "params": {
        "query": { "type": "string", "required": false, "visibility": "user-or-llm", "description": "Search query" },
        "apiKey": { "type": "string", "required": true, "visibility": "user-only", "description": "Hunter API Key" }
      },
      "outputs": {
        "companies": { "type": "array", "description": "Matching companies" }
      }
    },
    {
      "id": "hunter_companies_find",
      "name": "Hunter Find Company",
      "description": "Find details about a specific company.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "proxy": {
        "handler": "hunter",
        "operation": "companies-find"
      },
      "params": {
        "query": { "type": "string", "required": true, "visibility": "user-or-llm", "description": "Company name or domain" },
        "apiKey": { "type": "string", "required": true, "visibility": "user-only", "description": "Hunter API Key" }
      },
      "outputs": {
        "company": { "type": "object", "description": "Company details" }
      }
    },
    {
      "id": "hunter_email_count",
      "name": "Hunter Email Count",
      "description": "Get the total count of email addresses for a domain.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "proxy": {
        "handler": "hunter",
        "operation": "email-count"
      },
      "params": {
        "domain": { "type": "string", "required": true, "visibility": "user-or-llm", "description": "Domain to count emails for" },
        "apiKey": { "type": "string", "required": true, "visibility": "user-only", "description": "Hunter API Key" }
      },
      "outputs": {
        "total": { "type": "number", "description": "Total email count" },
        "personal": { "type": "number", "description": "Personal email count" },
        "generic": { "type": "number", "description": "Generic email count" }
      }
    }
  ]
}
