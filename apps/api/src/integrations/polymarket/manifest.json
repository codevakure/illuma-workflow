{
  "id": "polymarket",
  "name": "Polymarket",
  "version": "1.0.0",
  "description": "Prediction market data from Polymarket",
  "icon": "PolymarketIcon",

  "block": {
    "type": "polymarket",
    "name": "Polymarket",
    "description": "Prediction Markets",
    "longDescription": "Access prediction market data from Polymarket. Query markets, events, orderbooks, prices, positions, trades, and leaderboard data across Gamma, CLOB, and Data APIs.",
    "docsLink": "https://docs.sim.ai/tools/polymarket",
    "category": "tools",
    "bgColor": "#0052FF",
    "icon": "PolymarketIcon",
    "operations": [
      { "value": "get_markets", "label": "Get Markets", "toolId": "polymarket_get_markets" },
      { "value": "get_events", "label": "Get Events", "toolId": "polymarket_get_events" },
      { "value": "search", "label": "Search", "toolId": "polymarket_search" },
      { "value": "get_orderbook", "label": "Get Orderbook", "toolId": "polymarket_get_orderbook" },
      { "value": "get_price", "label": "Get Price", "toolId": "polymarket_get_price" },
      { "value": "get_midpoint", "label": "Get Midpoint", "toolId": "polymarket_get_midpoint" }
    ],
    "subBlocks": [
      {
        "id": "operation",
        "title": "Operation",
        "type": "dropdown",
        "options": [
          { "value": "get_markets", "label": "Get Markets" },
          { "value": "get_events", "label": "Get Events" },
          { "value": "search", "label": "Search" },
          { "value": "get_orderbook", "label": "Get Orderbook" },
          { "value": "get_price", "label": "Get Price" },
          { "value": "get_midpoint", "label": "Get Midpoint" }
        ],
        "default": "get_markets"
      },
      {
        "id": "query",
        "title": "Search Query",
        "type": "short-input",
        "placeholder": "Search markets...",
        "condition": { "field": "operation", "value": "search" }
      },
      {
        "id": "tokenId",
        "title": "Token ID",
        "type": "short-input",
        "placeholder": "Enter token ID...",
        "condition": { "field": "operation", "value": ["get_orderbook", "get_price", "get_midpoint"] }
      },
      {
        "id": "tag",
        "title": "Tag Filter",
        "type": "short-input",
        "placeholder": "e.g. politics, crypto",
        "condition": { "field": "operation", "value": ["get_markets", "get_events"] }
      },
      {
        "id": "limit",
        "title": "Limit",
        "type": "short-input",
        "placeholder": "25",
        "condition": { "field": "operation", "value": ["get_markets", "get_events", "search"] }
      }
    ],
    "tools": {
      "access": ["polymarket_get_markets", "polymarket_get_events", "polymarket_search", "polymarket_get_orderbook", "polymarket_get_price", "polymarket_get_midpoint"],
      "config": {
        "tool": "polymarket_{{operation}}"
      }
    },
    "inputs": {
      "query": { "type": "string", "description": "Search query" },
      "tokenId": { "type": "string", "description": "Token ID for CLOB operations" }
    },
    "outputs": {
      "markets": { "type": "json", "description": "Market data" },
      "events": { "type": "json", "description": "Event data" },
      "results": { "type": "json", "description": "Search or query results" },
      "price": { "type": "number", "description": "Current price" }
    }
  },

  "tools": [
    {
      "id": "polymarket_get_markets",
      "name": "Polymarket Get Markets",
      "description": "Get prediction markets from Polymarket.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "proxy": { "handler": "polymarket", "operation": "get-markets" },
      "params": {
        "tag": { "type": "string", "required": false, "visibility": "user-or-llm", "description": "Filter by tag" },
        "closed": { "type": "boolean", "required": false, "visibility": "user-only", "description": "Include closed markets" },
        "limit": { "type": "number", "required": false, "visibility": "user-only", "description": "Max results" },
        "offset": { "type": "number", "required": false, "visibility": "user-only", "description": "Pagination offset" }
      },
      "outputs": {
        "markets": { "type": "array", "description": "Market objects" }
      }
    },
    {
      "id": "polymarket_get_events",
      "name": "Polymarket Get Events",
      "description": "Get prediction events from Polymarket.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "proxy": { "handler": "polymarket", "operation": "get-events" },
      "params": {
        "tag": { "type": "string", "required": false, "visibility": "user-or-llm" },
        "limit": { "type": "number", "required": false, "visibility": "user-only" }
      },
      "outputs": {
        "events": { "type": "array", "description": "Event objects" }
      }
    },
    {
      "id": "polymarket_search",
      "name": "Polymarket Search",
      "description": "Search Polymarket markets and events.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "proxy": { "handler": "polymarket", "operation": "search" },
      "params": {
        "query": { "type": "string", "required": true, "visibility": "user-or-llm", "description": "Search query" },
        "limit": { "type": "number", "required": false, "visibility": "user-only" }
      },
      "outputs": {
        "results": { "type": "array", "description": "Search results" }
      }
    },
    {
      "id": "polymarket_get_orderbook",
      "name": "Polymarket Get Orderbook",
      "description": "Get orderbook for a Polymarket token.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "proxy": { "handler": "polymarket", "operation": "get-orderbook" },
      "params": {
        "tokenId": { "type": "string", "required": true, "visibility": "user-or-llm", "description": "Token ID" }
      },
      "outputs": {
        "bids": { "type": "array" },
        "asks": { "type": "array" }
      }
    },
    {
      "id": "polymarket_get_price",
      "name": "Polymarket Get Price",
      "description": "Get current price for a Polymarket token.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "proxy": { "handler": "polymarket", "operation": "get-price" },
      "params": {
        "tokenId": { "type": "string", "required": true, "visibility": "user-or-llm", "description": "Token ID" }
      },
      "outputs": {
        "price": { "type": "number", "description": "Current price" }
      }
    },
    {
      "id": "polymarket_get_midpoint",
      "name": "Polymarket Get Midpoint",
      "description": "Get midpoint price for a Polymarket token.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "proxy": { "handler": "polymarket", "operation": "get-midpoint" },
      "params": {
        "tokenId": { "type": "string", "required": true, "visibility": "user-or-llm", "description": "Token ID" }
      },
      "outputs": {
        "mid": { "type": "number", "description": "Midpoint price" }
      }
    }
  ]
}
