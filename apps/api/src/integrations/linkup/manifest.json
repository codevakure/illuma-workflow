{
  "id": "linkup",
  "name": "Linkup",
  "version": "1.0.0",
  "description": "AI-powered web search via Linkup",
  "icon": "LinkupIcon",

  "block": {
    "type": "linkup",
    "name": "Linkup",
    "description": "Search with Linkup",
    "longDescription": "Search the web using Linkup's AI-powered search API. Get comprehensive answers or detailed search results with source citations.",
    "docsLink": "https://docs.sim.ai/tools/linkup",
    "category": "tools",
    "bgColor": "#000000",
    "icon": "LinkupIcon",
    "authMode": "api_key",
    "subBlocks": [
      {
        "id": "query",
        "title": "Search Query",
        "type": "long-input",
        "placeholder": "Enter your search query...",
        "required": true
      },
      {
        "id": "outputType",
        "title": "Output Type",
        "type": "dropdown",
        "options": [
          { "value": "searchResults", "label": "Search Results" },
          { "value": "sourcedAnswer", "label": "Answer" }
        ],
        "default": "searchResults"
      },
      {
        "id": "depth",
        "title": "Search Depth",
        "type": "dropdown",
        "options": [
          { "value": "standard", "label": "Standard" },
          { "value": "deep", "label": "Deep" }
        ],
        "default": "standard"
      },
      {
        "id": "includeImages",
        "title": "Include Images",
        "type": "switch"
      },
      {
        "id": "fromDate",
        "title": "From Date",
        "type": "short-input",
        "placeholder": "YYYY-MM-DD"
      },
      {
        "id": "toDate",
        "title": "To Date",
        "type": "short-input",
        "placeholder": "YYYY-MM-DD"
      },
      {
        "id": "apiKey",
        "title": "API Key",
        "type": "short-input",
        "placeholder": "Enter your Linkup API key...",
        "required": true,
        "password": true
      }
    ],
    "tools": {
      "access": ["linkup_search"],
      "config": {
        "tool": "linkup_search"
      }
    },
    "inputs": {
      "query": { "type": "string", "required": true, "description": "The search query" },
      "outputType": { "type": "string", "description": "Output format type" },
      "depth": { "type": "string", "description": "Search depth" }
    },
    "outputs": {
      "answer": { "type": "string", "description": "AI-generated answer to the query" },
      "sources": { "type": "json", "description": "Array of source results" }
    }
  },

  "tools": [
    {
      "id": "linkup_search",
      "name": "Linkup Search",
      "description": "Search the web using Linkup's AI-powered search API.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "proxy": {
        "handler": "linkup",
        "operation": "search"
      },
      "params": {
        "query": {
          "type": "string",
          "required": true,
          "visibility": "user-or-llm",
          "description": "The search query"
        },
        "outputType": {
          "type": "string",
          "required": false,
          "visibility": "user-only",
          "description": "Output type: searchResults or sourcedAnswer"
        },
        "depth": {
          "type": "string",
          "required": false,
          "visibility": "user-only",
          "description": "Search depth: standard or deep"
        },
        "includeImages": {
          "type": "boolean",
          "required": false,
          "visibility": "user-only",
          "description": "Include images in results"
        },
        "fromDate": {
          "type": "string",
          "required": false,
          "visibility": "user-only",
          "description": "Start date filter (YYYY-MM-DD)"
        },
        "toDate": {
          "type": "string",
          "required": false,
          "visibility": "user-only",
          "description": "End date filter (YYYY-MM-DD)"
        },
        "apiKey": {
          "type": "string",
          "required": true,
          "visibility": "user-only",
          "description": "Linkup API Key"
        }
      },
      "outputs": {
        "answer": { "type": "string", "description": "AI-generated answer" },
        "sources": { "type": "array", "description": "Source results with titles and URLs" }
      }
    }
  ]
}
