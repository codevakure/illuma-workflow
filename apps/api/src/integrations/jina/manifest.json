{
  "id": "jina",
  "name": "Jina",
  "version": "1.0.0",
  "description": "Read web content and search using Jina AI",
  "icon": "JinaIcon",

  "block": {
    "type": "jina",
    "name": "Jina",
    "description": "Read & Search with Jina",
    "longDescription": "Read web content or search the web using Jina AI. Extracts clean, structured content from any URL or performs AI-powered web searches.",
    "docsLink": "https://docs.sim.ai/tools/jina",
    "category": "tools",
    "bgColor": "#FF6B6B",
    "icon": "JinaIcon",
    "authMode": "api_key",
    "subBlocks": [
      {
        "id": "operation",
        "title": "Operation",
        "type": "dropdown",
        "options": [
          { "value": "read", "label": "Read URL" },
          { "value": "search", "label": "Search" }
        ],
        "default": "read"
      },
      {
        "id": "url",
        "title": "URL",
        "type": "short-input",
        "placeholder": "https://example.com",
        "required": true,
        "condition": { "field": "operation", "value": "read" }
      },
      {
        "id": "query",
        "title": "Search Query",
        "type": "long-input",
        "placeholder": "Enter your search query...",
        "required": true,
        "condition": { "field": "operation", "value": "search" }
      },
      {
        "id": "apiKey",
        "title": "API Key",
        "type": "short-input",
        "placeholder": "Enter your Jina API key...",
        "required": true,
        "password": true
      }
    ],
    "tools": {
      "access": ["jina_read_url", "jina_search"],
      "config": {
        "tool": "{{operation}}"
      }
    },
    "inputs": {
      "url": { "type": "string", "description": "URL to read content from" },
      "query": { "type": "string", "description": "Search query" }
    },
    "outputs": {
      "content": { "type": "string", "description": "Extracted content or search results" },
      "title": { "type": "string", "description": "Page title" },
      "results": { "type": "json", "description": "Search results array" }
    }
  },

  "tools": [
    {
      "id": "jina_read_url",
      "name": "Jina Read URL",
      "description": "Extract clean content from any URL using Jina AI Reader.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "proxy": {
        "handler": "jina",
        "operation": "read-url"
      },
      "params": {
        "url": {
          "type": "string",
          "required": true,
          "visibility": "user-or-llm",
          "description": "The URL to read"
        },
        "returnFormat": {
          "type": "string",
          "required": false,
          "visibility": "user-only",
          "description": "Output format: markdown, html, text, screenshot, pageshot"
        },
        "apiKey": {
          "type": "string",
          "required": true,
          "visibility": "user-only",
          "description": "Jina API Key"
        }
      },
      "outputs": {
        "content": { "type": "string", "description": "Extracted page content" },
        "title": { "type": "string", "description": "Page title" },
        "url": { "type": "string", "description": "Source URL" }
      }
    },
    {
      "id": "jina_search",
      "name": "Jina Search",
      "description": "Search the web using Jina AI Search.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "proxy": {
        "handler": "jina",
        "operation": "search"
      },
      "params": {
        "query": {
          "type": "string",
          "required": true,
          "visibility": "user-or-llm",
          "description": "The search query"
        },
        "num": {
          "type": "number",
          "required": false,
          "visibility": "user-only",
          "description": "Number of results"
        },
        "apiKey": {
          "type": "string",
          "required": true,
          "visibility": "user-only",
          "description": "Jina API Key"
        }
      },
      "outputs": {
        "results": { "type": "array", "description": "Search results with title, URL, content" }
      }
    }
  ]
}
