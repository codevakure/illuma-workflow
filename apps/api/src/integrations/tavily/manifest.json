{
  "id": "tavily",
  "name": "Tavily",
  "version": "1.0.0",
  "description": "AI-powered web search, content extraction, crawling, and site mapping",
  "icon": "TavilyIcon",

  "block": {
    "type": "tavily",
    "name": "Tavily",
    "description": "Search with Tavily",
    "longDescription": "Perform AI-powered web searches, extract content, crawl websites, and map site structures using Tavily's suite of APIs.",
    "docsLink": "https://docs.sim.ai/tools/tavily",
    "category": "tools",
    "bgColor": "#0A0A0A",
    "icon": "TavilyIcon",
    "authMode": "api_key",
    "operations": [
      { "value": "search", "label": "Search", "toolId": "tavily_search" },
      { "value": "extract", "label": "Extract Content", "toolId": "tavily_extract" },
      { "value": "crawl", "label": "Crawl Website", "toolId": "tavily_crawl" },
      { "value": "map", "label": "Map Website", "toolId": "tavily_map" }
    ],
    "subBlocks": [
      {
        "id": "operation",
        "title": "Operation",
        "type": "dropdown",
        "options": [
          { "value": "search", "label": "Search" },
          { "value": "extract", "label": "Extract Content" },
          { "value": "crawl", "label": "Crawl Website" },
          { "value": "map", "label": "Map Website" }
        ],
        "default": "search"
      },
      {
        "id": "query",
        "title": "Search Query",
        "type": "long-input",
        "placeholder": "Enter your search query...",
        "required": true,
        "condition": { "field": "operation", "value": "search" }
      },
      {
        "id": "urls",
        "title": "URLs",
        "type": "long-input",
        "placeholder": "https://example.com",
        "required": true,
        "condition": { "field": "operation", "value": ["extract", "crawl", "map"] }
      },
      {
        "id": "topic",
        "title": "Topic",
        "type": "dropdown",
        "options": [
          { "value": "general", "label": "General" },
          { "value": "news", "label": "News" },
          { "value": "finance", "label": "Finance" }
        ],
        "condition": { "field": "operation", "value": "search" }
      },
      {
        "id": "search_depth",
        "title": "Search Depth",
        "type": "dropdown",
        "options": [
          { "value": "basic", "label": "Basic (1 credit)" },
          { "value": "advanced", "label": "Advanced (2 credits)" }
        ],
        "condition": { "field": "operation", "value": "search" }
      },
      {
        "id": "max_results",
        "title": "Max Results",
        "type": "short-input",
        "placeholder": "5",
        "condition": { "field": "operation", "value": "search" }
      },
      {
        "id": "apiKey",
        "title": "API Key",
        "type": "short-input",
        "placeholder": "Enter your Tavily API key...",
        "required": true,
        "password": true
      }
    ],
    "tools": {
      "access": ["tavily_search", "tavily_extract", "tavily_crawl", "tavily_map"],
      "config": {
        "tool": "tavily_{{operation}}"
      }
    },
    "inputs": {
      "query": { "type": "string", "description": "Search query" },
      "urls": { "type": "string", "description": "URLs to extract/crawl/map" }
    },
    "outputs": {
      "results": { "type": "json", "description": "Search or extraction results" },
      "answer": { "type": "string", "description": "AI-generated answer" },
      "response_time": { "type": "number", "description": "Response time in seconds" }
    }
  },

  "tools": [
    {
      "id": "tavily_search",
      "name": "Tavily Search",
      "description": "Perform AI-powered web searches using Tavily's search API.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "proxy": {
        "handler": "tavily",
        "operation": "search"
      },
      "params": {
        "query": {
          "type": "string",
          "required": true,
          "visibility": "user-or-llm",
          "description": "The search query"
        },
        "max_results": {
          "type": "number",
          "required": false,
          "visibility": "user-or-llm",
          "description": "Maximum number of results (1-20)"
        },
        "topic": {
          "type": "string",
          "required": false,
          "visibility": "user-or-llm",
          "description": "Category: general, news, or finance"
        },
        "search_depth": {
          "type": "string",
          "required": false,
          "visibility": "user-or-llm",
          "description": "Search scope: basic or advanced"
        },
        "apiKey": {
          "type": "string",
          "required": true,
          "visibility": "user-only",
          "description": "Tavily API Key"
        }
      },
      "outputs": {
        "query": { "type": "string", "description": "The executed query" },
        "results": { "type": "array", "description": "Ranked search results" },
        "answer": { "type": "string", "description": "AI-generated answer" },
        "response_time": { "type": "number", "description": "Response time in seconds" }
      }
    },
    {
      "id": "tavily_extract",
      "name": "Tavily Extract",
      "description": "Extract content from web pages using Tavily.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "proxy": {
        "handler": "tavily",
        "operation": "extract"
      },
      "params": {
        "urls": {
          "type": "string",
          "required": true,
          "visibility": "user-or-llm",
          "description": "URLs to extract content from"
        },
        "apiKey": {
          "type": "string",
          "required": true,
          "visibility": "user-only",
          "description": "Tavily API Key"
        }
      },
      "outputs": {
        "results": { "type": "array", "description": "Extracted content from URLs" }
      }
    },
    {
      "id": "tavily_crawl",
      "name": "Tavily Crawl",
      "description": "Crawl a website and extract content from multiple pages.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "proxy": {
        "handler": "tavily",
        "operation": "crawl"
      },
      "params": {
        "urls": {
          "type": "string",
          "required": true,
          "visibility": "user-or-llm",
          "description": "Base URL to crawl"
        },
        "apiKey": {
          "type": "string",
          "required": true,
          "visibility": "user-only",
          "description": "Tavily API Key"
        }
      },
      "outputs": {
        "results": { "type": "array", "description": "Crawled pages content" }
      }
    },
    {
      "id": "tavily_map",
      "name": "Tavily Map",
      "description": "Map a website's structure and discover pages.",
      "version": "1.0.0",
      "executionMode": "proxy",
      "proxy": {
        "handler": "tavily",
        "operation": "map"
      },
      "params": {
        "urls": {
          "type": "string",
          "required": true,
          "visibility": "user-or-llm",
          "description": "Base URL to map"
        },
        "apiKey": {
          "type": "string",
          "required": true,
          "visibility": "user-only",
          "description": "Tavily API Key"
        }
      },
      "outputs": {
        "results": { "type": "array", "description": "Discovered page URLs and structure" }
      }
    }
  ]
}
