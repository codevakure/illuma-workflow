{
  "id": "memory",
  "name": "Memory",
  "version": "1.0.0",
  "description": "Add memory store",
  "icon": "BrainIcon",
  "block": {
    "type": "memory",
    "name": "Memory",
    "description": "Add memory store",
    "longDescription": "Integrate Memory into the workflow. Can add, get a memory, get all memories, and delete memories.",
    "docsLink": "https://docs.sim.ai/tools/memory",
    "category": "blocks",
    "bgColor": "#F64F9E",
    "icon": "BrainIcon",
    "subBlocks": [
      {
        "id": "operation",
        "title": "Operation",
        "type": "dropdown",
        "default": "add",
        "options": [
          {
            "label": "Add Memory",
            "value": "add"
          },
          {
            "label": "Get All Memories",
            "value": "getAll"
          },
          {
            "label": "Get Memory",
            "value": "get"
          },
          {
            "label": "Delete Memory",
            "value": "delete"
          }
        ],
        "placeholder": "Select operation"
      },
      {
        "id": "id",
        "title": "Conversation ID",
        "type": "short-input",
        "placeholder": "Enter conversation ID (e.g., user-123)",
        "condition": {
          "field": "operation",
          "value": "add"
        },
        "required": true
      },
      {
        "id": "id",
        "title": "Conversation ID",
        "type": "short-input",
        "placeholder": "Enter conversation ID (e.g., user-123)",
        "condition": {
          "field": "operation",
          "value": "get"
        },
        "required": true
      },
      {
        "id": "id",
        "title": "Conversation ID",
        "type": "short-input",
        "placeholder": "Enter conversation ID (e.g., user-123)",
        "condition": {
          "field": "operation",
          "value": "delete"
        },
        "required": true
      },
      {
        "id": "role",
        "title": "Role",
        "type": "dropdown",
        "options": [
          {
            "label": "User",
            "value": "user"
          },
          {
            "label": "Assistant",
            "value": "assistant"
          },
          {
            "label": "System",
            "value": "system"
          }
        ],
        "placeholder": "Select agent role",
        "condition": {
          "field": "operation",
          "value": "add"
        },
        "required": true
      },
      {
        "id": "content",
        "title": "Content",
        "type": "short-input",
        "placeholder": "Enter message content",
        "condition": {
          "field": "operation",
          "value": "add"
        },
        "required": true
      }
    ],
    "tools": {
      "access": [
        "memory_add",
        "memory_get",
        "memory_get_all",
        "memory_delete"
      ],
      "config": {
        "tool": "memory_{{operation}}"
      }
    },
    "inputs": {
      "operation": {
        "type": "string",
        "description": "Operation to perform"
      },
      "id": {
        "type": "string",
        "description": "Memory identifier (conversation ID)"
      },
      "conversationId": {
        "type": "string",
        "description": "Conversation identifier"
      },
      "role": {
        "type": "string",
        "description": "Agent role"
      },
      "content": {
        "type": "string",
        "description": "Memory content"
      }
    },
    "outputs": {
      "memories": {
        "type": "json",
        "description": "Memory data"
      },
      "id": {
        "type": "string",
        "description": "Memory identifier"
      }
    }
  },
  "tools": [
    {
      "id": "memory_add",
      "name": "memory add",
      "description": "",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "memory",
        "operation": "add"
      }
    },
    {
      "id": "memory_get",
      "name": "memory get",
      "description": "",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "memory",
        "operation": "get"
      }
    },
    {
      "id": "memory_get_all",
      "name": "memory get all",
      "description": "",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "memory",
        "operation": "get_all"
      }
    },
    {
      "id": "memory_delete",
      "name": "memory delete",
      "description": "",
      "version": "1.0.0",
      "executionMode": "proxy",
      "params": {},
      "proxy": {
        "handler": "memory",
        "operation": "delete"
      }
    }
  ]
}