# =============================================================================
# Sim V2 API Server — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Server ---
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- Database ---
# Use 127.0.0.1 on Windows (localhost may resolve to IPv6 and fail)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/simstudio

# --- Auth ---
# Set to true to bypass auth in local development (all requests = test-user-id)
DISABLE_AUTH=true

# --- Security (use strong random values in production) ---
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-in-production-0123456789abcdef
ENCRYPTION_KEY=dev-only-encryption-key-change-in-production-0123456789abcdef
INTERNAL_API_SECRET=dev-only-internal-api-secret-change-in-production-0123456789abcdef
API_ENCRYPTION_KEY=dev-only-api-encryption-key-change-in-production-0123456789abcdef

# --- LLM Provider API Keys (at least one required) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Optional: Ollama / OpenRouter ---
# OLLAMA_BASE_URL=http://localhost:11434
# OPENROUTER_API_KEY=
